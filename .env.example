# PostgreSQL credentials
POSTGRES_USER=placeholder_user
POSTGRES_PASSWORD=placeholder_password
POSTGRES_DB=placeholder_db

# Odoo master password
ODOO_MASTER_PASSWORD=replace_with_long_random_master_password

# AI service URL — 'ai_service' is the Docker container name, NOT localhost
AI_SERVICE_URL=http://ai_service:8000

# Shared secret used by Odoo when calling protected FastAPI AI endpoints
AI_SERVICE_TOKEN=replace_with_long_random_service_token

# API Environment (development or production)
ENVIRONMENT=production

# Allowed CORS origins for FastAPI
ALLOWED_ORIGINS=http://localhost:8069
