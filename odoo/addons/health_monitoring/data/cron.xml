<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="cron_reanalyze_vitals" model="ir.cron">
    <field name="name">Health Monitor: Process AI Analysis Queue</field>
    <field name="model_id" ref="model_health_ai_analysis_job"/>
    <field name="state">code</field>
    <field name="code">model.cron_process_pending_jobs()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>   <!-- -1 = run forever -->
    <field name="active" eval="True"/>
  </record>
  
  <record id="cron_escalate_alerts" model="ir.cron">
    <field name="name">Health Monitor: Escalate Unresolved Alerts</field>
    <field name="model_id" ref="model_health_alert"/>
    <field name="state">code</field>
    <field name="code">model._cron_escalate_alerts()</field>
    <field name="interval_number">2</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
