<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_patient_history" model="ir.actions.report">
        <field name="name">Patient Vital History</field>
        <field name="model">health.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">health_monitoring.report_patient_history_view</field>
        <field name="report_file">health_monitoring.report_patient_history_view</field>
        <field name="print_report_name">'Vitals_History_%s' % (object.name or 'Patient')</field>
        <field name="binding_model_id" ref="model_health_patient"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_patient_history_view">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: 'Helvetica', 'Arial', sans-serif;">
                        
                        <!-- Header Section -->
                        <div style="background-color: #0D9488; color: #ffffff; padding: 15px; border-radius: 6px; margin-bottom: 25px;">
                            <h2 style="margin: 0 0 10px 0; font-size: 24px; border-bottom: 1px solid rgba(255,255,255,0.3); padding-bottom: 8px;">Patient Vital History</h2>
                            <table style="width: 100%; font-size: 14px; color: #ffffff;">
                                <tr>
                                    <td style="width: 50%; vertical-align: top;">
                                        <strong>Name:</strong> <span t-field="doc.name"/><br/>
                                        <strong>MRN:</strong> <span t-field="doc.mrn"/><br/>
                                        <strong>Age:</strong> <span t-field="doc.age"/> yrs<br/>
                                        <strong>Gender:</strong> <span style="text-transform: capitalize;" t-field="doc.gender"/>
                                    </td>
                                    <td style="width: 50%; vertical-align: top; text-align: right;">
                                        <strong>Assigned Doctor:</strong> <span t-field="doc.doctor_id.name"/><br/>
                                        <strong>Current Risk Level:</strong> <span style="text-transform: uppercase; font-weight: bold;" t-field="doc.risk_level"/><br/>
                                        <strong>Latest AI Score:</strong> <span t-field="doc.last_score"/>%
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Checkups History Table -->
                        <h4 style="color:#0D9488; border-bottom: 2px solid #0D9488; padding-bottom: 5px; margin-bottom: 15px; font-size: 18px;">Clinical Checkups History</h4>
                        <table class="table table-sm table-bordered" style="font-size: 11px; width: 100%; border-collapse: collapse; margin-bottom: 30px;">
                            <thead style="background-color: #E2E8F0; color: #334155;">
                                <tr>
                                    <th style="padding: 8px; border: 1px solid #CBD5E1;">Date</th>
                                    <th style="padding: 8px; border: 1px solid #CBD5E1;">BP (SYS/DIA)</th>
                                    <th style="padding: 8px; border: 1px solid #CBD5E1;">HR (bpm)</th>
                                    <th style="padding: 8px; border: 1px solid #CBD5E1;">SpO2 (%)</th>
                                    <th style="padding: 8px; border: 1px solid #CBD5E1;">Temp (°C)</th>
                                    <th style="padding: 8px; border: 1px solid #CBD5E1;">Glucose</th>
                                    <th style="padding: 8px; border: 1px solid #CBD5E1;">Resp</th>
                                    <th style="padding: 8px; border: 1px solid #CBD5E1;">AI Score</th>
                                    <th style="padding: 8px; border: 1px solid #CBD5E1;">Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.vital_record_ids.sorted(key=lambda r: r.recorded_at, reverse=True)" t-as="vital">
                                    <tr>
                                        <td style="padding: 6px; border: 1px solid #E2E8F0;"><span t-field="vital.recorded_at" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/></td>
                                        <td style="padding: 6px; border: 1px solid #E2E8F0;"><span t-field="vital.bp_systolic"/> / <span t-field="vital.bp_diastolic"/></td>
                                        <td style="padding: 6px; border: 1px solid #E2E8F0;"><span t-field="vital.heart_rate"/></td>
                                        <td style="padding: 6px; border: 1px solid #E2E8F0;"><span t-field="vital.spo2"/></td>
                                        <td style="padding: 6px; border: 1px solid #E2E8F0;"><span t-field="vital.temperature"/></td>
                                        <td style="padding: 6px; border: 1px solid #E2E8F0;"><span t-field="vital.glucose"/></td>
                                        <td style="padding: 6px; border: 1px solid #E2E8F0;"><span t-field="vital.respiratory_rate"/></td>
                                        <td style="padding: 6px; border: 1px solid #E2E8F0; font-weight: bold;"><t t-esc="round(vital.ai_score, 1)"/>%</td>
                                        <td style="padding: 6px; border: 1px solid #E2E8F0;">
                                            <span t-if="vital.status == 'critical'" style="color: #DC2626; font-weight: bold;">CRITICAL</span>
                                            <span t-elif="vital.status == 'warning'" style="color: #D97706; font-weight: bold;">WARNING</span>
                                            <span t-else="" style="color: #16A34A;">Normal</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        
                        <!-- Recent Alerts Table -->
                        <t t-if="doc.alert_ids">
                            <h4 style="color:#DC2626; border-bottom: 2px solid #DC2626; padding-bottom: 5px; margin-bottom: 15px; font-size: 18px; page-break-inside: avoid;">Recent Alerts</h4>
                            <table class="table table-sm table-bordered" style="font-size: 11px; width: 100%; border-collapse: collapse; page-break-inside: avoid;">
                                <thead style="background-color: #FEE2E2; color: #991B1B;">
                                    <tr>
                                        <th style="padding: 8px; border: 1px solid #FECACA; width: 18%;">Date</th>
                                        <th style="padding: 8px; border: 1px solid #FECACA; width: 12%;">Severity</th>
                                        <th style="padding: 8px; border: 1px solid #FECACA; width: 55%;">Message</th>
                                        <th style="padding: 8px; border: 1px solid #FECACA; width: 15%;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.alert_ids.sorted(key=lambda r: r.create_date, reverse=True)[:10]" t-as="alert">
                                        <tr t-attf-style="background-color: #{'#FEF2F2' if alert.severity == 'critical' else '#FFFBEB' if alert.severity == 'high' else '#F0F9FF' if alert.severity == 'medium' else '#ffffff'};">
                                            <td style="padding: 8px; border: 1px solid #E2E8F0;"><span t-field="alert.create_date" t-options='{"widget": "datetime"}'/></td>
                                            <td style="padding: 8px; border: 1px solid #E2E8F0; text-transform: uppercase; font-weight: bold; color: #{'#DC2626' if alert.severity == 'critical' else '#D97706'};"><span t-field="alert.severity"/></td>
                                            <td style="padding: 8px; border: 1px solid #E2E8F0; word-wrap: break-word;"><span t-field="alert.message"/></td>
                                            <td style="padding: 8px; border: 1px solid #E2E8F0; font-weight: 500;"><span t-field="alert.state"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
