<?xml version="1.0" encoding="utf-8"?>
<templates>
  <t t-name="health_monitoring.AnalyticsDashboard">
    <div class="sl-dashboard-container sl-analytics-dashboard">

      <!-- Header -->
      <div class="sl-analytics-header">
        <div class="sl-period-switcher">
          <button t-on-click="() => this.setPeriod('7')"
                  t-attf-class="sl-period-btn #{state.period=='7' ? 'is-active' : ''}">7 Days</button>
          <button t-on-click="() => this.setPeriod('30')"
                  t-attf-class="sl-period-btn #{state.period=='30' ? 'is-active' : ''}">30 Days</button>
          <button t-on-click="() => this.setPeriod('90')"
                  t-attf-class="sl-period-btn #{state.period=='90' ? 'is-active' : ''}">90 Days</button>
        </div>
      </div>

      <!-- KPI row -->
      <div class="sl-analytics-kpi-grid">
        <div class="sl-analytics-kpi-card sl-clickable" t-on-click="() => this.openVitals()">
          <div class="sl-analytics-kpi-label">Total Vitals Logged</div>
          <div class="sl-analytics-kpi-val" style="color:#185FA5;"><t t-esc="state.totalVitals"/></div>
          <div class="sl-analytics-kpi-sub">Selected period</div>
        </div>
        <div class="sl-analytics-kpi-card sl-clickable" t-on-click="() => this.openAlerts()">
          <div class="sl-analytics-kpi-label">Alerts Generated</div>
          <div class="sl-analytics-kpi-val" style="color:#F59E0B;"><t t-esc="state.totalAlerts"/></div>
          <div class="sl-analytics-kpi-sub">Selected period</div>
        </div>
        <div class="sl-analytics-kpi-card">
          <div class="sl-analytics-kpi-label">Avg AI Risk Score</div>
          <div class="sl-analytics-kpi-val" t-attf-style="color:#{state.avgAiScore>=70?'#E24B4A':state.avgAiScore>=40?'#F59E0B':'#10B981'};"><t t-esc="state.avgAiScore"/>%</div>
          <div class="sl-analytics-kpi-sub">Across selected period</div>
        </div>
        <div class="sl-analytics-kpi-card">
          <div class="sl-analytics-kpi-label">Critical Alert Rate</div>
          <div class="sl-analytics-kpi-val" t-attf-style="color:#{state.criticalRate>=30?'#E24B4A':state.criticalRate>=15?'#F59E0B':'#10B981'};"><t t-esc="state.criticalRate"/>%</div>
          <div class="sl-analytics-kpi-sub">Percentage of total alerts</div>
        </div>
      </div>

      <!-- Charts row 1: Trend & Severity -->
      <div class="sl-analytics-charts-row-1">
        <div class="sl-chart-card">
          <div class="sl-chart-label">Vitals Logged per Day</div>
          <div class="sl-chart-frame"><canvas t-ref="trendChart"/></div>
        </div>
        <div class="sl-chart-card">
          <div class="sl-chart-label">Alert Severity Breakdown</div>
          <div class="sl-chart-frame"><canvas t-ref="severityChart"/></div>
        </div>
      </div>
      
      <!-- Charts row 2: AI Score Line Chart & Risk Triage Distribution -->
      <div class="sl-analytics-charts-row-2">
          <!-- AI Score Trend -->
          <div class="sl-chart-card">
            <div class="sl-chart-header">
                <div class="sl-chart-label" style="margin-bottom:0;">Average AI Risk Score Trend</div>
                <button t-on-click="retrainModel" class="sl-btn-primary">
                    <svg style="width:14px;height:14px;margin-right:4px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    Retrain AI on Real Data
                </button>
            </div>
            <div class="sl-chart-frame sl-chart-frame--compact"><canvas t-ref="scoreChart"/></div>
          </div>
          
          <!-- Current Patient Triage Load (New Feature) -->
          <div class="sl-chart-card">
            <div class="sl-chart-label">Live Triage Distribution</div>
            <div class="sl-triage-list">
                <div class="sl-triage-row">
                    <div class="sl-triage-left">
                        <span class="sl-triage-dot" style="background:#E24B4A;"></span>
                        <span class="sl-triage-name">Critical Risk</span>
                    </div>
                    <span class="sl-triage-count" style="color:#E24B4A;"><t t-esc="state.triage.critical"/></span>
                </div>
                <div class="sl-triage-row">
                    <div class="sl-triage-left">
                        <span class="sl-triage-dot" style="background:#F59E0B;"></span>
                        <span class="sl-triage-name">High Risk</span>
                    </div>
                    <span class="sl-triage-count" style="color:#F59E0B;"><t t-esc="state.triage.high"/></span>
                </div>
                <div class="sl-triage-row">
                    <div class="sl-triage-left">
                        <span class="sl-triage-dot" style="background:#60A5FA;"></span>
                        <span class="sl-triage-name">Moderate Risk</span>
                    </div>
                    <span class="sl-triage-count" style="color:#60A5FA;"><t t-esc="state.triage.medium"/></span>
                </div>
                <div class="sl-triage-row">
                    <div class="sl-triage-left">
                        <span class="sl-triage-dot" style="background:#10B981;"></span>
                        <span class="sl-triage-name">Low Risk / Normal</span>
                    </div>
                    <span class="sl-triage-count" style="color:#10B981;"><t t-esc="state.triage.low"/></span>
                </div>
                <div class="sl-triage-row sl-triage-divider">
                    <div class="sl-triage-left">
                        <span class="sl-triage-dot" style="background:#94A3B8;"></span>
                        <span class="sl-triage-name sl-triage-name--muted">Already Handled</span>
                    </div>
                    <span class="sl-triage-count" style="color:#94A3B8;"><t t-esc="state.triage.handled"/></span>
                </div>
            </div>
          </div>
      </div>

      <!-- Loading overlay -->
      <div t-if="state.loading" class="sl-loading-overlay">
        <div class="sl-loading-inner">
            <div class="sl-spinner"></div>
            <div class="sl-loading-text">Loading analytics...</div>
        </div>
      </div>
    </div>
  </t>
</templates>
