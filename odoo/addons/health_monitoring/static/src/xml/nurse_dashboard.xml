<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="health_monitoring.NurseDashboardTemplate" owl="1">
    <div class="sl-dashboard-container sl-nurse-dashboard">

      <!-- White header -->
      <div class="sl-nurse-header">
        <div>
          <h1 class="sl-page-title">Central Monitor</h1>
          <p class="sl-page-subtitle">
            <t t-esc="state.wardName"/> &#183; Nurse <t t-esc="state.nurseName"/> &#183; <t t-esc="state.patients.length"/> patients assigned
          </p>
        </div>
        <div class="sl-row sl-gap-2">
          <button class="sl-btn-ghost" t-on-click="onOpenHandoffModal">Handoff</button>
          <button class="sl-btn-primary" t-on-click="onRefresh">Refresh</button>
        </div>
      </div>

      <!-- Body -->
      <div class="sl-nurse-body">

        <!-- Stats bar -->
        <div class="sl-stats-bar">
          <div class="sl-stat-pill sl-clickable" t-on-click="() => this.onOpenKpi('total')">
            <div class="sl-stat-num"><t t-esc="state.patients.length"/></div>
            <div class="sl-stat-label">Total</div>
          </div>
          <div class="sl-stat-pill stat-critical sl-clickable" t-on-click="() => this.onOpenKpi('critical')">
            <div class="sl-stat-num"><t t-esc="state.stats.critical"/></div>
            <div class="sl-stat-label">Critical</div>
          </div>
          <div class="sl-stat-pill stat-overdue sl-clickable" t-on-click="() => this.onOpenKpi('overdue')">
            <div class="sl-stat-num"><t t-esc="state.stats.overdue"/></div>
            <div class="sl-stat-label">Overdue</div>
          </div>
          <div class="sl-stat-pill stat-due-soon sl-clickable" t-on-click="() => this.onOpenKpi('due_soon')">
            <div class="sl-stat-num"><t t-esc="state.stats.dueSoon"/></div>
            <div class="sl-stat-label">Due Soon</div>
          </div>
          <div class="sl-stat-pill stat-ok sl-clickable" t-on-click="() => this.onOpenKpi('up_to_date')">
            <div class="sl-stat-num"><t t-esc="state.stats.upToDate"/></div>
            <div class="sl-stat-label">Up to Date</div>
          </div>
        </div>

        <!-- Patient card grid -->
        <div class="sl-bed-grid">
          <t t-foreach="state.patients" t-as="patient" t-key="patient.id">
            <div t-attf-class="sl-patient-card sl-status-#{patient.vitalsStatus} sl-clickable #{patient.risk_level === 'critical' ? 'sl-critical-pulse' : ''}"
                 t-on-click="() => this.onOpenPatient(patient.id)">

              <!-- Card header -->
              <div class="sl-pc-inner">
                <div class="sl-pc-header">
                  <div class="sl-row sl-gap-2">
                    <div class="sl-avatar">
                      <t t-esc="patient.name.substring(0,1).toUpperCase()"/>
                    </div>
                    <div>
                      <div class="sl-pc-name">
                        <t t-esc="patient.name"/>
                      </div>
                      <div class="sl-pc-meta"><t t-esc="patient.timeSinceVitals"/></div>
                    </div>
                  </div>
                  <div class="sl-col" style="align-items:flex-end;gap:3px;">
                    <span t-attf-class="sl-badge-#{patient.risk_level === 'high' ? 'warning' : (patient.risk_level || 'stable')}">
                      <t t-esc="(patient.risk_level || 'LOW').toUpperCase()"/>
                    </span>
                    <t t-if="patient.admission_status === 'admission_recommended'">
                      <span class="sl-badge-warning" style="font-size:9px;">Admit</span>
                    </t>
                  </div>
                </div>
              </div><!-- end pc-inner -->


              <!-- Vitals status banner (full-width) -->
              <div t-attf-class="sl-vitals-banner sl-banner-#{patient.vitalsStatus}">
                <span>
                  <t t-if="patient.vitalsStatus === 'overdue'">OVERDUE</t>
                  <t t-elif="patient.vitalsStatus === 'due_soon'">DUE SOON</t>
                  <t t-else="">UP TO DATE</t>
                </span>
                <span class="sl-banner-time">
                  <t t-if="patient.hoursSort != 999"><t t-esc="Math.round(patient.hoursSort * 10) / 10"/>h ago</t>
                  <t t-else="">No Vitals Yet</t>
                </span>
              </div>

              <!-- Sparkline -->
              <div class="sl-sparkline-wrap">
                <canvas t-att-id="'sparkline_' + patient.id"/>
              </div>

              <!-- Vital chips -->
              <div class="sl-vitals-chips" t-if="patient.latestHR">
                <span t-attf-class="sl-chip #{patient.hrAbnormal ? 'chip-danger' : patient.hrWarn ? 'chip-warn' : 'chip-ok'}">
                  HR <t t-esc="patient.latestHR"/>
                </span>
                <span t-attf-class="sl-chip #{patient.spo2Abnormal ? 'chip-danger' : patient.spo2Warn ? 'chip-warn' : 'chip-ok'}">
                  SpO&#8322; <t t-esc="patient.latestSpO2"/>%
                </span>
                <span t-attf-class="sl-chip #{patient.bpEqual ? 'chip-danger' : patient.bpAbnormal ? 'chip-danger' : patient.bpWarn ? 'chip-warn' : 'chip-ok'}"
                      t-att-title="patient.bpEqual ? 'Warning: systolic and diastolic nearly equal - check entry' : patient.bpLow ? 'Hypotension - risk of shock' : ''">
                  BP <t t-esc="patient.latestBP"/><t t-if="patient.bpEqual"> &#9888;</t>
                </span>
                <t t-if="patient.latestTemp">
                  <span t-attf-class="sl-chip #{patient.tempAbnormal ? 'chip-danger' : 'chip-ok'}">
                    <t t-esc="patient.latestTemp"/>&#176;
                  </span>
                </t>
              </div>
              <div class="sl-vitals-chips" t-if="!patient.latestHR">
                <span class="sl-chip chip-warn">No vitals recorded</span>
              </div>

              <!-- Log Vitals button -->
              <button class="sl-log-btn" t-on-click.stop="() => this.onLogVitals(patient.id)">
                + Log Vitals
              </button>

            </div><!-- end patient card -->
          </t>

          <t t-if="state.patients.length === 0">
            <div class="sl-empty">
              No patients assigned to your ward.
            </div>
          </t>
        </div><!-- end bed grid -->

        <!-- Bottom row -->
        <div class="sl-bottom-row">

          <!-- Vitals schedule -->
          <div class="sl-glass-card">
            <div class="sl-card-title">Vitals Schedule</div>
            <div class="sl-scrollable-list" style="max-height:200px;">
              <t t-foreach="state.schedule" t-as="patient" t-key="patient.id">
                <div class="sl-schedule-item">
                  <span class="sl-text-strong"><t t-esc="patient.name"/></span>
                  <div class="sl-row sl-gap-2">
                    <span t-if="patient.vitalsStatus === 'overdue'" class="sl-badge-critical"><t t-esc="patient.dueLabel"/></span>
                    <span t-elif="patient.vitalsStatus === 'due_soon'" class="sl-badge-warning">Due soon</span>
                    <span t-else="" class="sl-badge-stable">OK</span>
                    <button class="sl-btn-ghost sl-btn-sm" t-on-click="() => this.onLogVitals(patient.id)">Log</button>
                  </div>
                </div>
              </t>
              <t t-if="!state.schedule or state.schedule.length === 0">
                <div class="sl-empty">All vitals up to date!</div>
              </t>
            </div>
          </div>

          <!-- Ward activity -->
          <div class="sl-glass-card">
            <div class="sl-card-title">Ward Activity</div>
            <div class="sl-scrollable-list" style="max-height:200px;">
              <t t-foreach="state.activityFeed" t-as="item" t-key="item.id">
                <div class="sl-activity-item">
                  <span t-attf-class="sl-act-dot sl-act-dot-#{item.type === 'alert' ? 'alert' : item.type === 'vitals' ? 'vitals' : 'info'}"/>
                  <div>
                    <div class="sl-act-text"><t t-esc="item.text"/></div>
                    <div class="sl-act-time"><t t-esc="item.timeAgo"/></div>
                  </div>
                </div>
              </t>
              <t t-if="!state.activityFeed or state.activityFeed.length === 0">
                <div class="sl-empty">No recent activity.</div>
              </t>
            </div>
          </div>

        </div><!-- end bottom row -->
      </div><!-- end nurse body -->

      <!-- Handoff Modal -->
      <div t-if="state.showHandoff" class="sl-modal-overlay" t-on-click="onCloseHandoffModal">
        <div class="sl-modal" t-on-click.stop="">
          <div class="sl-modal-header">
            <h3 class="sl-modal-title">Shift Handoff Report</h3>
            <button class="sl-modal-close" t-on-click="onCloseHandoffModal">&#215;</button>
          </div>
          <div class="sl-handoff-tiles">
            <div class="sl-handoff-tile">
              <div class="sl-handoff-num t-brand"><t t-esc="state.patients.length"/></div>
              <div class="sl-handoff-label">Total</div>
            </div>
            <div class="sl-handoff-tile">
              <div class="sl-handoff-num t-critical"><t t-esc="state.stats.critical"/></div>
              <div class="sl-handoff-label">Critical</div>
            </div>
            <div class="sl-handoff-tile">
              <div class="sl-handoff-num t-warning"><t t-esc="state.stats.overdue"/></div>
              <div class="sl-handoff-label">Overdue</div>
            </div>
          </div>
          <h5 class="sl-modal-section-title">High Risk Patients</h5>
          <div class="sl-scrollable-list" style="max-height:220px;padding-right:6px;">
            <t t-foreach="state.handoffList" t-as="p" t-key="p.id">
              <div class="sl-mc-row">
                <strong class="sl-text-strong"><t t-esc="p.name"/></strong>
                <div class="sl-row sl-gap-2">
                  <t t-if="p.latestHR">
                    <span class="sl-badge-info">HR <t t-esc="p.latestHR"/></span>
                    <span class="sl-badge-info">SpO&#8322; <t t-esc="p.latestSpO2"/>%</span>
                  </t>
                  <span t-attf-class="sl-badge-#{p.risk_level === 'high' ? 'warning' : (p.risk_level || 'stable')}">
                    <t t-esc="(p.risk_level || 'LOW').toUpperCase()"/>
                  </span>
                </div>
              </div>
            </t>
            <t t-if="!state.handoffList or state.handoffList.length === 0">
              <div class="sl-empty">No high-risk patients.</div>
            </t>
          </div>
          <div class="sl-modal-footer">
            <button class="sl-btn-ghost" t-on-click="onCloseHandoffModal">Close</button>
            <button class="sl-btn-ghost" t-on-click="onExportCSV">Export CSV</button>
            <button class="sl-btn-primary" t-on-click="onPrintHandoff">Print</button>
          </div>
        </div>
      </div>

      <!-- Filter Results Modal -->
      <t t-if="state.filterModal and state.filterModal.show">
        <div class="sl-modal-overlay sl-modal-overlay-top" t-on-click="onCloseFilterModal">
          <div class="sl-modal-card" t-on-click.stop="">
            <div class="sl-modal-card-header">
              <div class="sl-modal-card-title">
                <t t-esc="state.filterModal.title"/>
                <span class="sl-modal-card-count">(<t t-esc="state.filterModal.patients.length"/> patients)</span>
              </div>
              <button class="sl-modal-close" t-on-click="onCloseFilterModal">&#215;</button>
            </div>
            <div class="sl-modal-card-body">
              <t t-foreach="state.filterModal.patients" t-as="p" t-key="p.id">
                <div class="sl-mc-row">
                  <div class="sl-row sl-gap-3">
                    <div class="sl-avatar sl-avatar-md">
                      <t t-esc="p.name.substring(0,1).toUpperCase()"/>
                    </div>
                    <div>
                      <div class="sl-text-strong"><t t-esc="p.name"/></div>
                      <div class="sl-text-caption"><t t-esc="p.timeSinceVitals"/></div>
                    </div>
                  </div>
                  <div class="sl-row sl-gap-2">
                    <span t-attf-class="sl-badge-#{p.risk_level === 'high' ? 'warning' : (p.risk_level || 'stable')}">
                      <t t-esc="(p.risk_level || 'low').toUpperCase()"/>
                    </span>
                    <button class="sl-btn-primary sl-btn-sm" t-on-click="() => this.onLogVitals(p.id)">Log Vitals</button>
                  </div>
                </div>
              </t>
              <t t-if="state.filterModal.patients.length === 0">
                <div class="sl-empty">No patients in this category.</div>
              </t>
            </div>
          </div>
        </div>
      </t>

    </div>

  </t>
</templates>
