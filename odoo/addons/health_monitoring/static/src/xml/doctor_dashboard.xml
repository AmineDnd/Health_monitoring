<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="health_monitoring.DoctorDashboardTemplate" owl="1">
    <div class="sl-dashboard-container sl-doctor-dashboard">

      <!-- White header -->
      <div class="sl-doctor-header">
        <div class="sl-dh-inner">
          <div>
            <h1 class="sl-page-title">Triage &amp; Analysis</h1>
            <p class="sl-page-subtitle">
              Dr. <t t-esc="state.doctorName"/> &#183;
              <t t-esc="state.wardName"/> &#183;
              <strong style="color:#A32D2D;font-weight:500;">
                <t t-esc="state.unclaimedAlerts.length"/> unclaimed
              </strong>
            </p>
          </div>
          <button class="sl-btn-primary" t-on-click="onRefresh"><t t-esc="'Refresh queue'"/></button>
        </div>
      </div>

      <!-- Split body -->
      <div class="sl-doctor-body">

        <!-- LEFT queue panel -->
        <div class="sl-queue-pane">

          <!-- Unclaimed section -->
          <div class="sl-queue-section unclaimed">
            <div class="sl-queue-header">
              <span class="sl-q-label">Unclaimed</span>
              <span class="sl-q-badge sl-q-badge--critical">
                <t t-esc="state.unclaimedAlerts.length"/>
              </span>
            </div>
            <div class="sl-scrollable-list">
              <t t-foreach="state.unclaimedAlerts" t-as="alert" t-key="alert.id">
                <div t-attf-class="sl-alert-card unclaimed-card #{alert.severity === 'high' ? 'severity-high' : ''}"
                     t-on-click="() => this.onViewPatient(alert)">
                  <div class="sl-row-between" style="margin-bottom:4px;">
                    <span class="sl-alert-patient"
                          t-on-click.stop="() => this.openPatientForm(alert.patient_id[0])">
                      <t t-esc="alert.patient_id[1]"/>
                    </span>
                    <span t-attf-class="sl-badge-#{alert.severity === 'high' ? 'warning' : alert.severity}">
                      <t t-esc="alert.severity"/>
                    </span>
                  </div>
                  <div class="sl-alert-headline"
                       t-on-click.stop="() => this.openAlertForm(alert.id)">
                    <t t-esc="alert.headline || 'Anomaly detected'"/>
                  </div>
                  <div class="sl-alert-actions">
                    <button class="sl-btn-claim"
                            t-on-click.stop="() => this.onClaimAlert(alert.id)">
                      Claim
                    </button>
                    <button class="sl-btn-trends"
                            t-on-click.stop="() => this.onViewPatient(alert)">
                      Trends
                    </button>
                  </div>
                </div>
              </t>
              <t t-if="state.unclaimedAlerts.length === 0">
                <div class="sl-empty">Inbox Zero! All alerts claimed.</div>
              </t>
            </div>
          </div>

          <!-- My Cases section -->
          <div class="sl-queue-section claimed">
            <div class="sl-queue-header">
              <span class="sl-q-label">My Cases</span>
              <span class="sl-q-badge sl-q-badge--info">
                <t t-esc="state.myActiveAlerts.length"/>
              </span>
            </div>
            <div class="sl-scrollable-list">
              <t t-foreach="state.myActiveAlerts" t-as="alert" t-key="alert.id">
                <div class="sl-alert-card claimed-card" t-on-click="() => this.onViewPatient(alert)">
                  <div class="sl-row-between" style="margin-bottom:4px;">
                    <span class="sl-alert-patient"
                          t-on-click.stop="() => this.openPatientForm(alert.patient_id[0])">
                      <t t-esc="alert.patient_id[1]"/>
                    </span>
                    <span class="sl-badge-info">In Progress</span>
                  </div>
                  <div class="sl-alert-headline"
                       t-on-click.stop="() => this.openAlertForm(alert.id)">
                    <t t-esc="alert.headline || 'Under investigation'"/>
                  </div>
                  <button class="sl-btn-resolve"
                          t-on-click.stop="() => this.onResolveAlert(alert.id)">
                    Resolve case
                  </button>
                </div>
              </t>
              <t t-if="state.myActiveAlerts.length === 0">
                <div class="sl-empty">No active cases.</div>
              </t>
            </div>
          </div>

        </div><!-- end queue pane -->

        <!-- RIGHT analysis pane -->
        <div class="sl-analysis-pane">

          <!-- Empty state -->
          <t t-if="!state.selectedPatient">
            <div class="sl-empty-state">
              <div class="sl-empty-icon-wrap">
                <i class="fa fa-line-chart" aria-hidden="true"></i>
              </div>
              <h4 class="sl-pt-name-lg" style="margin:0 0 8px;">Select a Patient</h4>
              <p class="sl-empty-desc">
                Patient trend and risk context will appear here.
              </p>
              <div class="sl-empty-stats">
                <div class="sl-empty-stat sl-empty-stat--critical">
                  <div class="sl-empty-stat-val"><t t-esc="state.unclaimedAlerts.length"/></div>
                  <div class="sl-empty-stat-lbl">Unclaimed</div>
                </div>
                <div class="sl-empty-stat sl-empty-stat--info">
                  <div class="sl-empty-stat-val"><t t-esc="state.myActiveAlerts.length"/></div>
                  <div class="sl-empty-stat-lbl">My Cases</div>
                </div>
              </div>
            </div>
          </t>

          <!-- Patient detail -->
          <div t-if="state.selectedPatient" class="sl-animate-in">

            <!-- Patient header card -->
            <div class="sl-patient-header-card">
              <div class="sl-row sl-gap-3">
                <div class="sl-pt-avatar-lg">
                  <t t-esc="state.selectedPatient.initials"/>
                </div>
                <div>
                  <div class="sl-pt-name-lg"><t t-esc="state.selectedPatient.name"/></div>
                  <div class="sl-pt-meta-sm">
                    Age <t t-esc="state.selectedPatient.age"/> &#183;
                    <t t-esc="state.selectedPatient.gender"/> &#183;
                    <t t-esc="state.wardName"/>
                  </div>
                </div>
              </div>
              <div class="sl-row sl-gap-3">
                <span t-attf-class="sl-badge-#{state.selectedPatient.risk_level === 'critical' ? 'critical' : (state.selectedPatient.risk_level === 'high' ? 'warning' : (state.selectedPatient.risk_level === 'medium' ? 'medium' : 'stable'))}">
                  <t t-esc="(state.selectedPatient.risk_level || 'LOW').toUpperCase()"/>
                </span>
                <button class="sl-btn-primary" t-on-click="onOpenPatientRecord">
                  <t t-esc="'Open record'"/>
                </button>
              </div>
            </div>

            <!-- Vitals grid -->
            <div class="sl-vitals-grid sl-vitals-grid--3col">
              <div class="sl-vital-box">
                <div t-attf-class="sl-vital-val #{state.vitals.hr_abnormal ? 'abnormal' : ''}">
                  <t t-esc="state.vitals.heart_rate || '--'"/>
                </div>
                <div class="sl-vital-label">Heart Rate</div>
              </div>
              <div class="sl-vital-box">
                <div t-attf-class="sl-vital-val #{state.vitals.spo2_abnormal ? 'abnormal' : ''}">
                  <t t-esc="state.vitals.spo2 || '--'"/>%
                </div>
                <div class="sl-vital-label">SpO&#8322;</div>
              </div>
              <div class="sl-vital-box">
                <div t-attf-class="sl-vital-val #{state.vitals.bp_abnormal ? 'abnormal' : ''}">
                  <t t-if="state.vitals.bp_systolic">
                    <t t-esc="state.vitals.bp_systolic"/>/<t t-esc="state.vitals.bp_diastolic"/>
                  </t>
                  <t t-else="">--</t>
                </div>
                <div class="sl-vital-label">Blood Pressure</div>
              </div>
              <div class="sl-vital-box">
                <div t-attf-class="sl-vital-val #{state.vitals.temp_abnormal ? 'abnormal' : ''}">
                  <t t-esc="state.vitals.temperature || '--'"/>&#176;
                </div>
                <div class="sl-vital-label">Temperature</div>
              </div>
              <div class="sl-vital-box">
                <div t-attf-class="sl-vital-val #{state.vitals.rr_abnormal ? 'abnormal' : ''}">
                  <t t-esc="state.vitals.respiratory_rate || '--'"/>
                </div>
                <div class="sl-vital-label">Resp. Rate</div>
              </div>
              <div class="sl-vital-box">
                <div t-attf-class="sl-vital-val #{state.vitals.glucose_abnormal ? 'abnormal' : ''}">
                  <t t-esc="state.vitals.glucose || '--'"/>
                </div>
                <div class="sl-vital-label">Glucose</div>
              </div>
            </div>

            <!-- AI Alert Summary - explains why patient is flagged -->
            <t t-if="state.activeAlert">
              <div t-attf-class="sl-alert-summary #{state.activeAlert.severity === 'critical' ? 'sl-alert-summary--critical' : 'sl-alert-summary--warning'}">
                <div class="sl-row-between" style="margin-bottom:4px;">
                  <span class="sl-alert-summary-label">
                    AI Alert - <t t-esc="(state.activeAlert.severity || '').toUpperCase()"/>
                  </span>
                  <span class="sl-alert-summary-time"><t t-esc="state.activeAlert.timeAgo"/></span>
                </div>
                <div class="sl-alert-summary-headline">
                  <t t-esc="state.activeAlert.headline || 'Anomaly detected by AI analysis'"/>
                </div>
                <t t-if="state.vitals.ai_score">
                  <div class="sl-alert-summary-score">AI Risk Score: <strong t-attf-style="color:#{state.vitals.ai_score >= 80 ? '#A32D2D' : state.vitals.ai_score >= 60 ? '#854F0B' : '#334155'};"><t t-esc="state.vitals.ai_score"/>%</strong></div>
                </t>
              </div>
            </t>

            <!-- Critical value warning banners -->
            <div class="sl-banners-stack">

              <!-- SpO2 critically low -->
              <t t-if="state.vitals and state.vitals.spo2 and state.vitals.spo2 &lt; 90">
                <div class="sl-crit-banner sl-crit-banner--critical">
                  <div class="sl-crit-dot"/>
                  <div class="sl-crit-msg">SpO&#8322; critically low at <t t-esc="state.vitals.spo2"/>% - immediate oxygen intervention</div>
                </div>
              </t>

              <!-- Heart rate dangerously high -->
              <t t-if="state.vitals and state.vitals.heart_rate and state.vitals.heart_rate &gt; 120">
                <div class="sl-crit-banner sl-crit-banner--critical">
                  <div class="sl-crit-dot"/>
                  <div class="sl-crit-msg">Tachycardia at <t t-esc="state.vitals.heart_rate"/> bpm - risk of arrhythmia</div>
                </div>
              </t>

              <!-- Heart rate dangerously low -->
              <t t-if="state.vitals and state.vitals.heart_rate and state.vitals.heart_rate &lt; 50">
                <div class="sl-crit-banner sl-crit-banner--critical">
                  <div class="sl-crit-dot"/>
                  <div class="sl-crit-msg">Bradycardia at <t t-esc="state.vitals.heart_rate"/> bpm - risk of cardiac arrest</div>
                </div>
              </t>

              <!-- BP critically high -->
              <t t-if="state.vitals and state.vitals.bp_systolic and state.vitals.bp_systolic &gt; 180">
                <div class="sl-crit-banner sl-crit-banner--critical">
                  <div class="sl-crit-dot"/>
                  <div class="sl-crit-msg">Hypertensive crisis at <t t-esc="state.vitals.bp_systolic"/>/<t t-esc="state.vitals.bp_diastolic"/> mmHg</div>
                </div>
              </t>

              <!-- BP critically low (hypotension) -->
              <t t-if="state.vitals and state.vitals.bp_systolic and state.vitals.bp_systolic &lt; 90">
                <div class="sl-crit-banner sl-crit-banner--critical">
                  <div class="sl-crit-dot"/>
                  <div class="sl-crit-msg">Hypotension at <t t-esc="state.vitals.bp_systolic"/>/<t t-esc="state.vitals.bp_diastolic"/> mmHg - risk of shock</div>
                </div>
              </t>

              <!-- Respiratory rate high (tachypnea) -->
              <t t-if="state.vitals and state.vitals.respiratory_rate and state.vitals.respiratory_rate &gt; 25">
                <div class="sl-crit-banner sl-crit-banner--critical">
                  <div class="sl-crit-dot"/>
                  <div class="sl-crit-msg">Tachypnea at <t t-esc="state.vitals.respiratory_rate"/> br/min - respiratory distress</div>
                </div>
              </t>

              <!-- Glucose critically low -->
              <t t-if="state.vitals and state.vitals.glucose and state.vitals.glucose &lt; 70">
                <div class="sl-crit-banner sl-crit-banner--critical">
                  <div class="sl-crit-dot"/>
                  <div class="sl-crit-msg">Hypoglycemia at <t t-esc="state.vitals.glucose"/> mg/dL - immediate glucose needed</div>
                </div>
              </t>

              <!-- Fever -->
              <t t-if="state.vitals and state.vitals.temperature and state.vitals.temperature &gt; 38.5">
                <div class="sl-crit-banner sl-crit-banner--warning">
                  <div class="sl-crit-dot"/>
                  <div class="sl-crit-msg">Fever at <t t-esc="state.vitals.temperature"/>&#176;C - infection risk</div>
                </div>
              </t>

            </div>

            <!-- Heart rate trend chart -->
            <div class="sl-glass-card" style="margin-bottom:12px;">
              <div class="sl-card-title"><t t-esc="'Vitals Trend - Last 12 Readings'"/></div>

              <t t-if="!state.showVitalsChart">
                <div class="sl-chart-no-data">
                  <div class="sl-chart-no-data-title">No trend data yet</div>
                  <div class="sl-chart-no-data-sub">Log 3 or more vitals to see the chart</div>
                </div>
              </t>

              <!-- Chart canvas: only when 3+ vitals exist -->
              <t t-if="state.showVitalsChart">
                <div style="height:220px;position:relative;">
                  <canvas t-ref="trendChart"/>
                </div>
              </t>

            </div>

            <!-- Risk factors -->
            <div class="sl-glass-card">
              <div class="sl-card-title"><t t-esc="'Risk Factors'"/></div>
              <div class="sl-risk-grid">
                <div class="sl-risk-item">
                  <span class="sl-risk-label">Cardiac</span>
                  <div class="sl-risk-bar-wrap">
                    <div class="sl-risk-bar-fill" t-attf-style="width:#{state.risk.cardiac}%;background:#{state.risk.cardiacColor};"/>
                  </div>
                </div>
                <div class="sl-risk-item">
                  <span class="sl-risk-label">Respiratory</span>
                  <div class="sl-risk-bar-wrap">
                    <div class="sl-risk-bar-fill" t-attf-style="width:#{state.risk.respiratory}%;background:#{state.risk.respiratoryColor};"/>
                  </div>
                </div>
                <div class="sl-risk-item">
                  <span class="sl-risk-label">Hypoxia</span>
                  <div class="sl-risk-bar-wrap">
                    <div class="sl-risk-bar-fill" t-attf-style="width:#{state.risk.hypoxia}%;background:#{state.risk.hypoxiaColor};"/>
                  </div>
                </div>
                <div class="sl-risk-item">
                  <span class="sl-risk-label">Blood Pressure</span>
                  <div class="sl-risk-bar-wrap">
                    <div class="sl-risk-bar-fill" t-attf-style="width:#{state.risk.bloodPressure}%;background:#{state.risk.bloodPressureColor};"/>
                  </div>
                </div>
                <div class="sl-risk-item">
                  <span class="sl-risk-label">Thermoregulation</span>
                  <div class="sl-risk-bar-wrap">
                    <div class="sl-risk-bar-fill" t-attf-style="width:#{state.risk.thermoregulation}%;background:#{state.risk.thermoregulationColor};"/>
                  </div>
                </div>
                <div class="sl-risk-item">
                  <span class="sl-risk-label">Metabolic</span>
                  <div class="sl-risk-bar-wrap">
                    <div class="sl-risk-bar-fill" t-attf-style="width:#{state.risk.metabolic}%;background:#{state.risk.metabolicColor};"/>
                  </div>
                </div>
              </div>
            </div>

          </div><!-- end selected patient -->
        </div><!-- end analysis pane -->
      </div><!-- end doctor body -->
    </div>
  </t>
</templates>
