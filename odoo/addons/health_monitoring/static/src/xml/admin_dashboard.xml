<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="health_monitoring.AdminDashboardTemplate" owl="1">
    <div class="sl-dashboard-container sl-admin-dashboard">

      <!-- Operations header -->
      <div class="sl-admin-header">
        <div class="sl-row-baseline sl-gap-3">
          <h1 class="sl-title">Hospital Operations</h1>
          <span class="sl-live-badge">
            <span class="sl-live-dot"/>
            Live &#183; <t t-esc="state.currentTime"/>
          </span>
        </div>
        <div class="sl-row sl-gap-2">
            <button t-on-click="() => this.setRange('today')"
                    t-att-class="state.dateRange === 'today' ? 'sl-header-btn active' : 'sl-header-btn'">
              <t t-esc="'Today'"/>
            </button>
            <button t-on-click="() => this.setRange('week')"
                    t-att-class="state.dateRange === 'week' ? 'sl-header-btn active' : 'sl-header-btn'">
              <t t-esc="'This Week'"/>
            </button>
            <button t-on-click="() => this.setRange('month')"
                    t-att-class="state.dateRange === 'month' ? 'sl-header-btn active' : 'sl-header-btn'">
              <t t-esc="'Month'"/>
            </button>
            <button t-on-click="onManualRefresh"
                    t-att-class="state.isRefreshing ? 'sl-header-btn sl-btn-refreshing' : 'sl-header-btn'"
                    t-att-disabled="state.isRefreshing"
                    title="Refresh dashboard data">
              <t t-if="state.isRefreshing">&#8987;</t>
              <t t-else="">&#8635; Refresh</t>
            </button>
        </div>
      </div>

      <!-- Light body -->
      <div class="sl-admin-body">

        <!-- Loading state -->
        <t t-if="state.isLoading">
          <div class="sl-kpi-row">
            <div class="sl-kpi-card sl-skeleton" style="height:100px;"><div class="sl-skeleton-shimmer"/></div>
            <div class="sl-kpi-card sl-skeleton" style="height:100px;"><div class="sl-skeleton-shimmer"/></div>
            <div class="sl-kpi-card sl-skeleton" style="height:100px;"><div class="sl-skeleton-shimmer"/></div>
            <div class="sl-kpi-card sl-skeleton" style="height:100px;"><div class="sl-skeleton-shimmer"/></div>
          </div>
        </t>

        <t t-else="">

          <!-- KPI Row -->
          <div class="sl-kpi-row sl-animate-in">
            <div class="sl-kpi-card kpi-patients sl-clickable" t-on-click="openAllPatients">
              <div class="sl-kpi-label">Active Patients</div>
              <div class="sl-kpi-value"><t t-esc="state.kpi.activePatients"/></div>
              <div class="sl-kpi-delta up">+<t t-esc="state.kpi.activeDelta"/> admitted today</div>
            </div>
            <div class="sl-kpi-card kpi-critical sl-clickable" t-on-click="openAllAlerts">
              <div class="sl-kpi-label">Critical Alerts</div>
              <div class="sl-kpi-value"><t t-esc="state.kpi.criticalAlerts"/></div>
              <div class="sl-kpi-delta"><t t-esc="state.kpi.criticalDelta"/> vs yesterday</div>
            </div>
            <div class="sl-kpi-card kpi-response sl-clickable" t-on-click="openSlaAlerts">
              <div class="sl-kpi-label">SLA Compliance</div>
              <div t-attf-class="sl-kpi-value #{state.slaCompliance >= 80 ? 'sl-text-success' : state.slaCompliance >= 60 ? 'sl-text-warning' : 'sl-text-critical'}">
                  <t t-esc="state.slaCompliance"/>%
              </div>
              <div class="sl-kpi-delta">Responded within 5 min</div>
            </div>
            <div class="sl-kpi-card kpi-anomalies sl-clickable" t-on-click="openAiAnomalies">
              <div class="sl-kpi-label">AI Anomalies Today</div>
              <div class="sl-kpi-value"><t t-esc="state.kpi.aiAnomalies"/></div>
              <div class="sl-kpi-delta">alerts triggered today</div>
            </div>
          </div>

          <!-- Row 2: Ward Capacity + Patient Status + Doctor Performance -->
          <div class="sl-grid-admin-row">

            <!-- Ward Capacity -->
            <div class="sl-glass-card">
              <div class="sl-card-title">Ward Capacity</div>
              <div class="sl-ward-list sl-scrollable-list" style="max-height:260px;">
                <t t-foreach="state.wards" t-as="ward" t-key="ward.id">
                  <div class="sl-list-row sl-clickable" t-on-click="() => this.openWard(ward.id)">
                    <span class="sl-truncate" style="width:150px;flex-shrink:0;font-size:12px;color:var(--sl-text-body);"
                          t-att-title="ward.name">
                      <t t-esc="ward.name"/>
                    </span>
                    <div class="sl-progress-track">
                      <div t-attf-class="sl-progress-fill #{ward.occupancy_percentage >= 85 ? 'sl-fill-critical' : ward.occupancy_percentage >= 65 ? 'sl-fill-warning' : 'sl-fill-success'}"
                           t-attf-style="width:#{ward.occupancy_percentage}%;"/>
                    </div>
                    <span t-attf-class="sl-tabular #{ward.occupancy_percentage === 0 ? 'sl-text-faint' : ward.occupancy_percentage >= 85 ? 'sl-text-critical' : ward.occupancy_percentage >= 65 ? 'sl-text-warning' : 'sl-text-success'}"
                          style="font-size:11px;font-weight:600;width:36px;text-align:right;">
                      <t t-esc="ward.occupancy_percentage"/>%
                    </span>
                    <span class="sl-text-faint sl-tabular" style="font-size:11px;width:44px;flex-shrink:0;">
                      &#183; <t t-esc="ward.current_occupancy"/> pts
                    </span>
                  </div>
                </t>
                <t t-if="!state.wards or state.wards.length === 0">
                  <div class="sl-empty">No ward data.</div>
                </t>
              </div>
            </div>

            <!-- Patient Status Donut -->
            <div class="sl-glass-card sl-col">
              <div class="sl-card-title">Patient Status</div>
              <div class="sl-flex-1" style="position:relative;min-height:160px;">
                <canvas t-ref="statusChart"/>
              </div>
              <div class="sl-donut-legend">
                <div>
                  <div class="sl-legend-num sl-legend-stable"><t t-esc="state.patientStatus.stable"/></div>
                  <div class="sl-legend-label">STABLE</div>
                </div>
                <div>
                  <div class="sl-legend-num sl-legend-warning"><t t-esc="state.patientStatus.warning"/></div>
                  <div class="sl-legend-label">WARNING</div>
                </div>
                <div>
                  <div class="sl-legend-num sl-legend-critical"><t t-esc="state.patientStatus.critical"/></div>
                  <div class="sl-legend-label">CRITICAL</div>
                </div>
              </div>
            </div>

            <!-- Doctor Performance -->
            <div class="sl-glass-card sl-col" style="align-self:start;">
              <div class="sl-card-title">Doctor Performance</div>
              <div class="sl-card-sublabel">Ranked by alerts resolved</div>
              <div class="sl-doctor-list sl-scrollable-list" style="max-height:260px;">
                <t t-foreach="state.leaderboard" t-as="doc" t-key="doc.id">
                  <div class="sl-doctor-row sl-list-row sl-clickable"
                       t-attf-style="border-left:3px solid #{doc.borderColor};padding-left:8px;min-height:44px;"
                       t-on-click="() => this.openDoctorAlerts(doc.id, doc.name)">
                    <div class="sl-flex-1">
                      <div class="sl-truncate" style="font-size:13px;font-weight:600;color:var(--sl-text-strong);"><t t-esc="doc.name"/></div>
                      <div class="sl-doctor-meta"><t t-esc="doc.total"/> handled</div>
                    </div>
                    <div class="sl-row sl-gap-2" style="flex-shrink:0;justify-content:flex-end;">
                      <span class="sl-badge-stable"><t t-esc="doc.resolved"/> resolved</span>
                      <span class="sl-badge-critical" t-if="doc.critical > 0"><t t-esc="doc.critical"/> critical</span>
                    </div>
                  </div>
                </t>
                <t t-if="state.leaderboard.length === 0">
                  <div class="sl-empty">No data yet.</div>
                </t>
              </div>
            </div>
          </div>

          <!-- Row 3: Alert Trend + AI Insights -->
          <div class="sl-grid-admin-row-2">
            <div class="sl-glass-card">
              <div class="sl-card-title">Alert Trend</div>
              <div style="height:160px;position:relative;">
                <canvas t-ref="trendChart"/>
              </div>
            </div>
            <div class="sl-glass-card sl-col">
              <div class="sl-card-title">AI Insights</div>
              <div class="sl-scrollable-list sl-flex-1" style="max-height:160px;">
                <t t-foreach="state.insights" t-as="insight" t-key="insight">
                  <div class="sl-insight-item">
                    <t t-esc="insight"/>
                  </div>
                </t>
                <t t-if="!state.insights or state.insights.length === 0">
                  <div class="sl-empty">Collecting data...</div>
                </t>
              </div>
            </div>
          </div>

          <!-- Row 4: Recent Escalations -->
          <div class="sl-glass-card">
            <div class="sl-card-title">Recent Critical Escalations</div>
            <div class="sl-scrollable-list" style="max-height:240px;padding-right:14px;">
              <t t-foreach="state.escalations" t-as="esc" t-key="esc.id">
                <div class="sl-escalation-item" t-on-click="() => this.openAlert(esc.id)">
                  <div class="sl-esc-dot"/>
                  <div class="sl-flex-1">
                    <div class="sl-esc-text"><t t-esc="esc.headline"/></div>
                    <div class="sl-esc-meta">
                      <t t-esc="esc.timeAgo"/>
                      <t t-if="esc.patient_id">
                        <span class="sl-esc-patient-link"
                              t-on-click.stop="() => this.openPatient(esc.patient_id[0])">
                          &#183; <t t-esc="esc.patient_id[1]"/>
                        </span>
                      </t>
                    </div>
                  </div>
                  <span t-attf-class="sl-badge-#{esc.severity === 'high' ? 'warning' : esc.severity}" style="flex-shrink:0;margin-left:8px;margin-right:2px;">
                    <t t-esc="esc.severity"/>
                  </span>
                </div>
              </t>
              <t t-if="state.escalations.length === 0">
                <div class="sl-empty">No recent escalations.</div>
              </t>
            </div>
          </div>

        </t><!-- end t-else -->
      </div><!-- end admin body -->
    </div>
  </t>
</templates>
