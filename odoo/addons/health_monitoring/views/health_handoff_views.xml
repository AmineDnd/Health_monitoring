<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_handoff_form" model="ir.ui.view">
        <field name="name">health.handoff.form</field>
        <field name="model">health.handoff</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="outgoing_nurse_id" readonly="1"/>
                            <field name="incoming_nurse_id" domain="[('groups_id', 'in', %(health_monitoring.group_health_nurse)d)]"/>
                            <field name="ward_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Enter critical patient handoff details..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_health_handoff_tree" model="ir.ui.view">
        <field name="name">health.handoff.tree</field>
        <field name="model">health.handoff</field>
        <field name="arch" type="xml">
            <tree string="Shift Handoffs" create="1" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="outgoing_nurse_id" string="Outgoing Nurse" widget="many2one_avatar_user"/>
                <field name="incoming_nurse_id" string="Incoming Nurse" widget="many2one_avatar_user"/>
                <field name="ward_id" string="Ward"/>
                <field name="notes" string="Handoff Notes"/>
            </tree>
        </field>
    </record>

    <record id="action_health_handoff" model="ir.actions.act_window">
        <field name="name">Nurse Handoff</field>
        <field name="res_model">health.handoff</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="context">{'default_outgoing_nurse_id': uid}</field>
    </record>

    <record id="action_health_handoff_new" model="ir.actions.act_window">
        <field name="name">New Shift Handoff</field>
        <field name="res_model">health.handoff</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_outgoing_nurse_id': uid}</field>
    </record>
</odoo>
