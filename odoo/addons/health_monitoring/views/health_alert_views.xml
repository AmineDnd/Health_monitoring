<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ALERTS KANBAN VIEW -->
  <record id="view_alerts_kanban" model="ir.ui.view">
    <field name="name">health.alert.kanban</field>
    <field name="model">health.alert</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state" class="o_kanban_small_column sl-kanban-pipeline" on_create="quick_create" quick_create_view="health_monitoring.view_alerts_form">
        <field name="patient_id"/>
        <field name="severity" readonly="1"/>
        <field name="message"/>
        <field name="ai_confidence"/>
        <field name="create_date"/>
        <field name="state"/>
        <field name="assigned_doctor_id"/>
        <progressbar field="severity" colors='{"critical": "danger", "high": "warning", "medium": "info", "low": "success"}'/>
        <templates>
          <t t-name="kanban-box">
            <div t-attf-class="oe_kanban_card oe_kanban_global_click sl-pipeline-card mb-3 #{record.severity.raw_value == 'critical' and record.state.raw_value == 'new' ? 'sl-pulse-critical' : ''}"
                 t-attf-style="border-top: 3px solid #{record.severity.raw_value == 'critical' ? '#E24B4A' : record.severity.raw_value == 'high' ? '#F59E0B' : record.severity.raw_value == 'medium' ? '#185FA5' : '#16A34A'}; border-radius: 10px; overflow: hidden; background: #fff; border: 1px solid #EEF2F7; border-top-width: 3px; box-shadow: none;">

              <div style="padding:12px;">
                <!-- Header: avatar + name + severity badge -->
                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">
                  <div style="display:flex;align-items:center;gap:8px;">
                    <div style="width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:11px;flex-shrink:0;"
                         t-attf-style="background:#{record.severity.raw_value == 'critical' ? '#E24B4A' : '#64748B'};">
                      <t t-esc="record.patient_id.value ? record.patient_id.value.substring(0,1).toUpperCase() : 'P'"/>
                    </div>
                    <div>
                      <div style="font-weight:600;color:#0F172A;font-size:13px;line-height:1.2;"><field name="patient_id"/></div>
                      <div style="font-size:11px;color:#94A3B8;"><field name="create_date"/></div>
                    </div>
                  </div>
                  <span t-attf-style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:600;background:#{record.severity.raw_value == 'critical' ? '#FCEBEB' : record.severity.raw_value == 'high' ? '#FAEEDA' : record.severity.raw_value == 'medium' ? '#E6F1FB' : '#EAF3DE'};color:#{record.severity.raw_value == 'critical' ? '#A32D2D' : record.severity.raw_value == 'high' ? '#854F0B' : record.severity.raw_value == 'medium' ? '#0C447C' : '#3B6D11'};">
                    <field name="severity"/>
                  </span>
                </div>

                <!-- AI message preview -->
                <div style="font-size:11px;color:#64748B;line-height:1.5;padding:8px 10px;background:#F8FAFC;border-radius:8px;margin-bottom:8px;min-height:42px;overflow:hidden;">
                  <field name="parsed_message_html" widget="html"/>
                </div>

                <!-- AI anomaly score + state -->
                <div style="display:flex;justify-content:space-between;align-items:center;padding-top:8px;border-top:1px solid #F1F5F9;margin-bottom:8px;">
                  <div style="display:flex;align-items:center;gap:6px;">
                    <span style="font-size:11px;font-weight:600;color:#185FA5;">AI SCORE: <t t-esc="Math.round(record.ai_confidence.raw_value)"/>%</span>
                    <span t-attf-style="font-size:9px;font-weight:700;padding:2px 6px;border-radius:4px;color:#fff;background:#{record.ai_confidence.raw_value >= 80 ? '#16A34A' : record.ai_confidence.raw_value >= 50 ? '#F59E0B' : '#E24B4A'};">
                      <t t-if="record.ai_confidence.raw_value >= 80">HIGH ANOMALY</t>
                      <t t-elif="record.ai_confidence.raw_value >= 50">MODERATE</t>
                      <t t-else="">LOW ANOMALY</t>
                    </span>
                  </div>
                  <div>
                    <field name="state" widget="label_selection" options="{'classes': {'new': 'default', 'investigating': 'info', 'resolved': 'success'}}"/>
                  </div>
                </div>

                <!-- Action buttons -->
                <div style="display:flex;gap:6px;" t-if="record.state.raw_value != 'resolved'">
                  <button type="object" name="action_claim_alert"
                          style="flex:1;padding:5px 0;background:#E6F1FB;color:#0C447C;border:1px solid #B5D4F4;border-radius:7px;font-size:11px;font-weight:500;cursor:pointer;"
                          invisible="assigned_doctor_id != False">
                    Claim Alert
                  </button>
                  <button type="object" name="action_acknowledge"
                          style="flex:1;padding:5px 0;background:#FAEEDA;color:#854F0B;border:1px solid #FAC775;border-radius:7px;font-size:11px;font-weight:500;cursor:pointer;"
                          invisible="state != 'new' or assigned_doctor_id == False">
                    Ack
                  </button>
                  <button type="object" name="action_resolve"
                          style="flex:1;padding:5px 0;background:#EAF3DE;color:#3B6D11;border:1px solid #C0DD97;border-radius:7px;font-size:11px;font-weight:500;cursor:pointer;"
                          invisible="state != 'investigating' or assigned_doctor_id == False">
                    Resolve
                  </button>
                </div>

                <!-- Doctor / Unclaimed label -->
                <div t-if="record.assigned_doctor_id.raw_value" style="font-size:11px;color:#185FA5;font-weight:500;text-align:center;margin-top:6px;">
                  <field name="assigned_doctor_id"/>
                </div>
                <div t-else="" style="font-size:10px;font-weight:600;color:#E24B4A;text-align:center;margin-top:6px;">
                  UNCLAIMED
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- ALERTS TREE VIEW -->
  <record id="view_alerts_tree" model="ir.ui.view">
    <field name="name">health.alert.tree</field>
    <field name="model">health.alert</field>
    <field name="arch" type="xml">
      <tree create="0"
            decoration-danger="severity=='critical'"
            decoration-muted="state=='resolved'"
            class="sl-clinical-grid" limit="20">
        <field name="create_date" string="Time"/>
        <field name="patient_id" widget="many2one_avatar" string="Patient Identity"/>
        <field name="severity" string="Triage Level" widget="badge"
               decoration-danger="severity=='critical'"
               decoration-warning="severity=='high'"
               decoration-muted="severity in ['medium', 'low']"/>
        <field name="headline" string="Clinical Headline"/>
        <field name="ai_confidence" string="AI Score" widget="progressbar"
               decoration-danger="ai_confidence >= 70"
               decoration-warning="ai_confidence >= 40 and ai_confidence &lt; 70"
               decoration-success="ai_confidence &lt; 40"
               optional="show"/>
        <field name="state" string="Status" widget="badge"
               decoration-success="state=='resolved'"
               decoration-info="state=='investigating'"
               decoration-muted="state=='new'"/>
        <field name="response_time_minutes" string="Response (min)"
               optional="show"
               decoration-danger="response_time_minutes > 10 and response_time_minutes > 0"
               decoration-warning="response_time_minutes > 5 and response_time_minutes &lt;= 10"
               decoration-success="response_time_minutes > 0 and response_time_minutes &lt;= 5"/>
        <field name="assigned_doctor_id" widget="many2one_avatar_user" string="Claimed By"/>
        <button name="action_claim_alert" type="object" string="Claim"
                invisible="assigned_doctor_id != False"
                groups="health_monitoring.group_health_doctor,health_monitoring.group_health_admin"/>
        <button name="action_acknowledge" type="object" string="Hold"
                invisible="state != 'new' or assigned_doctor_id == False"
                groups="health_monitoring.group_health_doctor,health_monitoring.group_health_admin"/>
        <button name="action_resolve" type="object" string="Done"
                invisible="state != 'investigating' or assigned_doctor_id == False"
                groups="health_monitoring.group_health_doctor,health_monitoring.group_health_admin"/>
      </tree>
    </field>
  </record>

  <!-- ALERT FORM VIEW -->
  <record id="view_alerts_form" model="ir.ui.view">
    <field name="name">health.alert.form</field>
    <field name="model">health.alert</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_claim_alert" type="object" string="Claim Alert"
                  class="oe_highlight btn-primary"
                  invisible="assigned_doctor_id != False"
                  groups="health_monitoring.group_health_doctor,health_monitoring.group_health_admin"/>
          <button name="action_acknowledge" type="object" string="Acknowledge"
                  class="btn-secondary"
                  invisible="state not in ['new']"
                  groups="health_monitoring.group_health_doctor,health_monitoring.group_health_admin"/>
          <button name="action_resolve" type="object" string="Mark Resolved"
                  class="btn-success"
                  invisible="state == 'resolved'"
                  groups="health_monitoring.group_health_doctor,health_monitoring.group_health_admin"/>
          <field name="state" widget="statusbar" statusbar_visible="new,investigating,resolved"/>

        </header>
        <sheet>
          <div class="oe_title mb-4">
            <h1><field name="patient_id" readonly="1" widget="many2one_avatar" style="color:#0F172A;"/></h1>
          </div>
          <div class="row">
            <!-- Trigger Details -->
            <div class="col-md-6 mb-3">
              <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;height:100%;">
                <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                  <div style="width:7px;height:7px;border-radius:50%;background:#185FA5;flex-shrink:0;"></div>
                  Trigger Details
                </div>
                <group>
                  <field name="severity" readonly="1" widget="badge"
                         decoration-danger="severity=='critical'"
                         decoration-warning="severity=='high'"
                         decoration-info="severity=='medium'"
                         decoration-success="severity=='low'"/>
                  <field name="status" widget="badge" decoration-warning="status=='pending'" decoration-success="status=='handled'" decoration-danger="status=='escalated'"/>
                  <field name="vital_record_id" readonly="1"/>
                  <field name="created_at" readonly="1" string="Triggered At"/>
                  <field name="handled_at" readonly="1" invisible="status != 'handled'"/>
                  <field name="ai_confidence" widget="percentpie" string="AI Anomaly Score"/>
                  <field name="assigned_doctor_id" widget="many2one_avatar_user"/>
                  <field name="escalation_level" invisible="status != 'escalated'"/>
                </group>
              </div>
            </div>

            <!-- Resolution Status -->
            <div class="col-md-6 mb-3">
              <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;height:100%;" invisible="state == 'new'">
                <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                  <div style="width:7px;height:7px;border-radius:50%;background:#16A34A;flex-shrink:0;"></div>
                  Resolution Status
                </div>
                <group>
                  <field name="acknowledged" readonly="1"/>
                  <field name="acknowledged_by" readonly="1" widget="many2one_avatar_user"/>
                  <field name="acknowledged_at" readonly="1"/>
                  <field name="resolution_notes" readonly="1" invisible="state != 'resolved'"/>
                </group>
              </div>
            </div>
          </div>

          <!-- AI Analysis card -->
          <div class="row mt-3">
            <div class="col-12">
              <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;">
                <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                  <div style="width:7px;height:7px;border-radius:50%;background:#E24B4A;flex-shrink:0;"></div>
                  SmartLab AI Analysis &amp; Clinical Context
                </div>
                <div style="background:#F8FAFC;border-radius:10px;padding:14px;">
                  <field name="parsed_message_html" nolabel="1" readonly="1"/>
                </div>
              </div>
            </div>
          </div>
          <!-- Patient Clinical Notes — visible to all roles for continuity of care -->
          <div class="row mt-3"
               invisible="not patient_nurse_notes and not patient_doctor_notes">
            <div class="col-12">
              <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;">
                <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                  <div style="width:7px;height:7px;border-radius:50%;background:#7C3AED;flex-shrink:0;"></div>
                  Patient Clinical Notes
                </div>
                <div style="display:flex;gap:14px;flex-wrap:wrap;">
                  <div style="flex:1;min-width:220px;border:1px solid #D1FAE5;border-radius:8px;overflow:hidden;"
                       invisible="not patient_nurse_notes">
                    <div style="padding:8px 12px;background:#F0FDF4;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#065F46;">
                      Nurse Notes
                    </div>
                    <div style="padding:10px 12px;font-size:12px;color:#134E4A;line-height:1.6;white-space:pre-wrap;">
                      <field name="patient_nurse_notes" nolabel="1" readonly="1"/>
                    </div>
                  </div>
                  <div style="flex:1;min-width:220px;border:1px solid #BFDBFE;border-radius:8px;overflow:hidden;"
                       invisible="not patient_doctor_notes">
                    <div style="padding:8px 12px;background:#EFF6FF;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#1E3A5F;">
                      Doctor Notes
                    </div>
                    <div style="padding:10px 12px;font-size:12px;color:#1E3A5F;line-height:1.6;white-space:pre-wrap;">
                      <field name="patient_doctor_notes" nolabel="1" readonly="1"/>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <notebook>
            <page string="Notification Audit">
              <field name="notification_log_ids" readonly="1">
                <tree create="0" edit="0" delete="0" string="Notification History">
                  <field name="create_date" string="Sent At"/>
                  <field name="channel" widget="badge"/>
                  <field name="purpose"/>
                  <field name="user_id" string="Recipient"/>
                  <field name="recipient" string="Address / Chat ID" optional="show"/>
                  <field name="result" widget="badge"
                         decoration-success="result == 'sent'"
                         decoration-warning="result in ['skipped', 'cooldown']"
                         decoration-danger="result == 'failed'"/>
                  <field name="result_detail" string="Detail" optional="show"/>
                  <field name="payload_excerpt" string="Message Preview" optional="show"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <div class="oe_chatter">
          <field name="message_ids"/>
        </div>
      </form>
    </field>
  </record>

  <record id="view_alerts_pivot" model="ir.ui.view">
    <field name="name">health.alert.pivot</field>
    <field name="model">health.alert</field>
    <field name="arch" type="xml">
      <pivot string="Alert Analysis">
        <field name="create_date" interval="month" type="row"/>
        <field name="severity" type="col"/>
        <field name="patient_id" type="measure"/>
      </pivot>
    </field>
  </record>

  <!-- ALERTS SEARCH VIEW -->
  <record id="view_alerts_search" model="ir.ui.view">
    <field name="name">health.alert.search</field>
    <field name="model">health.alert</field>
    <field name="arch" type="xml">
      <search string="Search Alerts">
        <field name="patient_id"/>
        <field name="assigned_doctor_id"/>

        <!-- Workflow State -->
        <filter string="Active Alerts" name="active" domain="[('state', '!=', 'resolved')]"/>
        <filter string="Unclaimed" name="unclaimed" domain="[('state', '=', 'new'), ('assigned_doctor_id', '=', False)]"/>
        <filter string="Under Investigation" name="investigating" domain="[('state', '=', 'investigating')]"/>
        <filter string="New (Unacknowledged)" name="new" domain="[('state', '=', 'new')]"/>
        <filter string="Resolved" name="resolved" domain="[('state', '=', 'resolved')]"/>
        <separator/>

        <!-- Escalation -->
        <filter string="Escalated" name="escalated" domain="[('status', '=', 'escalated')]"/>
        <filter string="Overdue Response (&gt;10 min)" name="overdue_response" domain="[('response_time_minutes', '&gt;', 10)]"/>
        <separator/>

        <!-- Severity -->
        <filter string="Critical Severity" name="critical" domain="[('severity', '=', 'critical')]"/>
        <filter string="High Severity" name="high" domain="[('severity', '=', 'high')]"/>
        <filter string="Critical + High" name="critical_high" domain="[('severity', 'in', ['critical', 'high'])]"/>
        <separator/>

        <!-- Date -->
        <filter string="Today's Alerts" name="today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('create_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
        <filter string="Last 7 Days" name="last_week" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>

        <group expand="0" string="Group By">
          <filter string="Patient" name="group_by_patient" context="{'group_by':'patient_id'}"/>
          <filter string="Severity" name="group_by_severity" context="{'group_by':'severity'}"/>
          <filter string="Workflow State" name="group_by_state" context="{'group_by':'state'}"/>
          <filter string="Assigned Doctor" name="group_by_doctor" context="{'group_by':'assigned_doctor_id'}"/>
          <filter string="Date" name="group_by_date" context="{'group_by':'create_date:day'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_alerts" model="ir.actions.act_window">
    <field name="name">Doctor Inbox Zero</field>
    <field name="res_model">health.alert</field>
    <field name="view_mode">kanban,tree,form,pivot</field>
    <field name="search_view_id" ref="view_alerts_search"/>
    <field name="context">{'search_default_active': 1}</field>
    <field name="help" type="html">
      <div class="text-center w-100 p-5 mt-5">
        <div style="font-size:56px;color:#16A34A;margin-bottom:20px;">&#10003;</div>
        <h2 style="font-size:28px;font-weight:700;color:#0F172A;letter-spacing:-0.5px;">Inbox Zero Achieved</h2>
        <p style="font-size:15px;color:#64748B;max-width:500px;margin:12px auto 0;">
          All patients are currently stable. No active clinical anomalies require attention.
        </p>
      </div>
    </field>
  </record>

  <record id="action_all_alerts" model="ir.actions.act_window">
    <field name="name">All Alerts</field>
    <field name="res_model">health.alert</field>
    <field name="view_mode">tree,kanban,form,pivot</field>
  </record>

  <record id="action_patient_alerts" model="ir.actions.act_window">
    <field name="name">Patient Alerts</field>
    <field name="res_model">health.alert</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('patient_id', '=', active_id)]</field>
  </record>

  <record id="action_patient_critical_alerts" model="ir.actions.act_window">
    <field name="name">Critical Alerts</field>
    <field name="res_model">health.alert</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('patient_id', '=', active_id), ('severity', '=', 'critical')]</field>
  </record>

</odoo>
