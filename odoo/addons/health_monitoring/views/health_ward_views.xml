<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- WARD LIST VIEW -->
  <record id="view_health_ward_tree" model="ir.ui.view">
    <field name="name">health.ward.tree</field>
    <field name="model">health.ward</field>
    <field name="arch" type="xml">
      <tree string="Wards" class="sl-clinical-grid">
        <field name="name"/>
        <field name="ward_type"/>
        <field name="floor_number"/>
        <field name="current_occupancy"/>
        <field name="capacity"/>
      </tree>
    </field>
  </record>

  <!-- WARD FORM VIEW -->
  <record id="view_health_ward_form" model="ir.ui.view">
    <field name="name">health.ward.form</field>
    <field name="model">health.ward</field>
    <field name="arch" type="xml">
      <form string="Ward">
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="e.g. ICU Wing A"/>
            </h1>
          </div>

          <div class="row">
            <!-- Ward Information card -->
            <div class="col-md-6 mb-3">
              <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:14px 16px;">
                <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;margin-bottom:10px;display:flex;align-items:center;gap:7px;">
                  <div style="width:7px;height:7px;border-radius:50%;background:#185FA5;flex-shrink:0;"></div>
                  Ward Information
                </div>
                <group>
                  <field name="ward_type"/>
                  <field name="floor_number"/>
                  <field name="contact_extension"/>
                  <field name="description"/>
                </group>
              </div>
            </div>

            <!-- Capacity &amp; Personnel card -->
            <div class="col-md-6 mb-3">
              <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:14px 16px;">
                <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;margin-bottom:10px;display:flex;align-items:center;gap:7px;">
                  <div style="width:7px;height:7px;border-radius:50%;background:#16A34A;flex-shrink:0;"></div>
                  Capacity &amp; Personnel
                </div>
                <group>
                  <field name="capacity"/>
                  <field name="current_occupancy"/>
                  <field name="doctor_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
              </div>
            </div>
          </div>

          <notebook>
            <page string="Patients in Ward">
              <field name="patient_ids" readonly="1">
                <tree class="sl-clinical-grid">
                  <field name="name"/>
                  <field name="age"/>
                  <field name="gender"/>
                  <field name="risk_level" widget="badge"
                         decoration-danger="risk_level == 'critical'"
                         decoration-warning="risk_level == 'high'"
                         decoration-info="risk_level == 'medium'"
                         decoration-success="risk_level == 'low'"/>
                  <field name="status"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids" widget="mail_followers"/>
          <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>
    </field>
  </record>

  <!-- WARD KANBAN VIEW -->
  <record id="view_health_ward_kanban" model="ir.ui.view">
    <field name="name">health.ward.kanban</field>
    <field name="model">health.ward</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_dashboard">
        <field name="name"/>
        <field name="ward_type"/>
        <field name="current_occupancy"/>
        <field name="capacity"/>
        <field name="floor_number"/>
        <field name="contact_extension"/>
        <field name="active_alert_count"/>
        <field name="unclaimed_alert_count"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click"
                 t-attf-style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;box-shadow:none;overflow:hidden;border-left:3px solid #{record.unclaimed_alert_count.raw_value > 0 ? '#E24B4A' : record.active_alert_count.raw_value > 0 ? '#F59E0B' : '#16A34A'};">
              <div style="padding:14px 16px;">
                <!-- Header -->
                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">
                  <div style="font-size:15px;font-weight:700;color:#0F172A;"><field name="name"/></div>
                  <div style="display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end;">
                    <span t-if="record.unclaimed_alert_count.raw_value > 0"
                          style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:600;background:#FCEBEB;color:#A32D2D;border:1px solid #F7C1C1;">
                      <field name="unclaimed_alert_count"/> Unclaimed
                    </span>
                    <span t-if="record.active_alert_count.raw_value > 0 and record.unclaimed_alert_count.raw_value == 0"
                          style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:600;background:#FAEEDA;color:#854F0B;border:1px solid #FAC775;">
                      <field name="active_alert_count"/> Active
                    </span>
                    <span t-if="record.active_alert_count.raw_value == 0"
                          style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:600;background:#EAF3DE;color:#3B6D11;border:1px solid #C0DD97;">
                      All Clear
                    </span>
                  </div>
                </div>

                <div style="font-size:12px;color:#64748B;margin-bottom:10px;">
                  <field name="ward_type"/> — <field name="floor_number"/>
                </div>

                <!-- Occupancy bar -->
                <div style="display:flex;justify-content:space-between;font-size:11px;color:#64748B;margin-bottom:5px;">
                  <span>Occupancy</span>
                  <strong style="color:#0F172A;"><t t-esc="record.current_occupancy.raw_value"/> / <t t-esc="record.capacity.raw_value"/></strong>
                </div>
                <div style="height:5px;border-radius:3px;background:#E2E8F0;overflow:hidden;">
                  <t t-set="occ_pct" t-value="record.capacity.raw_value ? (record.current_occupancy.raw_value / record.capacity.raw_value) * 100 : 0"/>
                  <div role="progressbar"
                       t-attf-style="height:100%;border-radius:3px;width:#{occ_pct}%;background:#{occ_pct > 90 ? '#E24B4A' : (occ_pct > 75 ? '#F59E0B' : '#16A34A')};"
                       aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"/>
                </div>

                <!-- Footer: ext + doctors -->
                <div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px;">
                  <span style="font-size:11px;color:#64748B;">Ext: <field name="contact_extension"/></span>
                  <field name="doctor_ids" widget="many2many_avatar_user"/>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="action_health_ward" model="ir.actions.act_window">
    <field name="name">Wards / Services</field>
    <field name="res_model">health.ward</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create the first hospital ward
      </p>
      <p>
        Manage hospital wings, intensive care units, and specialized departments.
      </p>
    </field>
  </record>
</odoo>
