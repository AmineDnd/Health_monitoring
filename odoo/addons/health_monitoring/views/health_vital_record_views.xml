<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- VITALS FORM VIEW -->
  <record id="view_vitals_form" model="ir.ui.view">
    <field name="name">health.vital.record.form</field>
    <field name="model">health.vital.record</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button string="Analyze &amp; Save" type="object" name="action_check_and_save" class="btn-primary ms-2" invisible="id"/>
          <field name="status" widget="statusbar" statusbar_visible="normal,warning,critical"/>
        </header>
        <sheet>
          <field name="anomaly_detected" invisible="1"/>
          <field name="confirmation_state" invisible="1"/>
          <field name="confirmation_required" invisible="1"/>
          <field name="ai_analysis_state" invisible="1"/>

          <!-- Page title - no fa icon -->
          <div class="oe_title mb-4">
            <div style="margin-bottom:14px;">
              <div style="font-size:18px;font-weight:600;color:#0F172A;letter-spacing:-0.3px;">Clinical Checkup</div>
              <div style="font-size:12px;color:#64748B;margin-top:3px;">Enter vital signs for AI analysis</div>
            </div>
          </div>

          <!-- Two-column layout: left cards + right AI panel -->
          <div class="row">
            <!-- Left: Clinical Data -->
            <div class="col-md-8">
              <div class="row sl-card-container mb-4">
                <!-- Cardiovascular card -->
                <div class="col-md-6 mb-3">
                  <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;height:100%;">
                    <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                      <div style="width:7px;height:7px;border-radius:50%;background:#185FA5;flex-shrink:0;"></div>
                      Cardiovascular
                    </div>
                    <group>
                      <field name="patient_id" widget="many2one_avatar" options="{'no_create': True}"/>
                      <label for="bp_systolic" string="Blood Pressure"/>
                      <div class="o_row">
                        <field name="bp_systolic" class="sl-numeric" placeholder="SYS"/>
                        <span class="mx-1">/</span>
                        <field name="bp_diastolic" class="sl-numeric" placeholder="DIA"/>
                      </div>
                      <field name="heart_rate" class="sl-numeric" string="Heart Rate (bpm)"/>
                    </group>
                  </div>
                </div>
                <!-- Respiratory card -->
                <div class="col-md-6 mb-3">
                  <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;height:100%;">
                    <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                      <div style="width:7px;height:7px;border-radius:50%;background:#16A34A;flex-shrink:0;"></div>
                      Respiratory
                    </div>
                    <group>
                      <field name="recorded_at"/>
                      <field name="spo2" class="sl-numeric" string="SpO2 (%)"/>
                      <field name="respiratory_rate" class="sl-numeric" string="Respiration (/min)"/>
                    </group>
                  </div>
                </div>
              </div>

              <!-- Metabolic card -->
              <div class="row sl-card-container">
                <div class="col-md-12">
                  <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;">
                    <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                      <div style="width:7px;height:7px;border-radius:50%;background:#F59E0B;flex-shrink:0;"></div>
                      Metabolic &amp; Temp
                    </div>
                    <div class="row">
                      <div class="col-md-6">
                        <group>
                          <field name="temperature" class="sl-numeric" string="Body Temp (C)"/>
                        </group>
                      </div>
                      <div class="col-md-6">
                        <group>
                          <field name="glucose" class="sl-numeric" string="Glucose (mg/dL)"/>
                        </group>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right: AI Assessment Panel -->
            <div class="col-md-4">
              <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px;min-height:400px;display:flex;flex-direction:column;gap:12px;">

                <!-- Status banner -->
                <div invisible="ai_analysis_state not in ['pending', 'retrying', 'failed']"
                     style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;background:#EFF6FF;border:1px solid #BFDBFE;">
                  <div style="width:32px;height:32px;border-radius:8px;background:#185FA5;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;font-weight:700;">
                    AI
                  </div>
                  <div style="flex:1;min-width:0;">
                    <div style="font-size:13px;font-weight:700;color:#0C447C;line-height:1.2;">AI Analysis <field name="ai_analysis_state" nolabel="1"/></div>
                    <div style="font-size:11px;color:#185FA5;margin-top:2px;">Vitals are saved while analysis runs in the background.</div>
                  </div>
                </div>
                <!-- ANOMALY: red pill header -->
                <div invisible="not anomaly_detected or ai_analysis_state in ['pending', 'retrying']"
                     style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;background:#FFF1F2;border:1px solid #FECDD3;">
                  <div style="width:32px;height:32px;border-radius:8px;background:#E24B4A;flex-shrink:0;display:flex;align-items:center;justify-content:center;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                      <path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div style="flex:1;min-width:0;">
                    <div style="font-size:13px;font-weight:700;color:#9F1239;line-height:1.2;">Anomaly Detected</div>
                    <div style="font-size:11px;color:#BE123C;margin-top:2px;">Clinical values outside normal range</div>
                  </div>
                </div>
                <!-- NORMAL: green pill header -->
                <div invisible="anomaly_detected or ai_analysis_state in ['pending', 'retrying']"
                     style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;background:#F0FDF4;border:1px solid #BBF7D0;">
                  <div style="width:32px;height:32px;border-radius:8px;background:#16A34A;flex-shrink:0;display:flex;align-items:center;justify-content:center;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                      <path d="M20 6L9 17l-5-5" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div style="flex:1;min-width:0;">
                    <div style="font-size:13px;font-weight:700;color:#14532D;line-height:1.2;">All Vitals Normal</div>
                    <div style="font-size:11px;color:#15803D;margin-top:2px;">No anomalies detected</div>
                  </div>
                </div>

                <!-- Risk Score gauge -->
                <div style="background:#F8FAFC;border:1px solid #EEF2F7;border-radius:10px;padding:14px;">
                  <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#94A3B8;margin-bottom:4px;">Clinical Risk Score</div>
                  <div style="display:flex;justify-content:center;min-height:130px;">
                    <field name="ai_score" widget="gauge" options="{'max_field': 100, 'title': 'AI Score'}" nolabel="1"/>
                  </div>
                </div>

                <!-- Clinical analysis text -->
                <div style="background:#F8FAFC;border:1px solid #EEF2F7;border-radius:8px;padding:12px;flex:1;overflow-y:auto;">
                  <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#94A3B8;margin-bottom:6px;">Clinical Analysis</div>
                  <field name="parsed_clinical_hints" nolabel="1"/>
                  <field name="ai_analysis_error" invisible="not ai_analysis_error" readonly="1"/>
                </div>
              </div>
            </div>
          </div>
          <div invisible="confirmation_state != 'pending'"
               style="margin-top:12px;background:#FFF7ED;border:1px solid #FED7AA;border-radius:10px;padding:12px 14px;color:#7C2D12;">
            <strong>Extreme values require confirmation before AI analysis.</strong>
            <div style="white-space:pre-line;font-size:12px;margin-top:6px;">
              <field name="confirmation_warnings" nolabel="1" readonly="1"/>
            </div>
          </div>
          <group invisible="confirmation_state == 'not_required'">
            <field name="confirmed_by" readonly="1"/>
            <field name="confirmed_at" readonly="1"/>
            <field name="confirmation_notes" readonly="1"/>
            <field name="ai_payload_context" readonly="1"/>
            <field name="ai_model_version" readonly="1"/>
            <field name="ai_analysis_job_id" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_vitals_tree" model="ir.ui.view">
    <field name="name">health.vital.record.tree</field>
    <field name="model">health.vital.record</field>
    <field name="arch" type="xml">
      <tree decoration-danger="status=='critical'" class="sl-clinical-grid" limit="20">
        <field name="recorded_at" string="Checked At"/>
        <field name="patient_id" widget="many2one_avatar" string="Patient"/>
        <field name="heart_rate" string="Pulse" widget="integer"/>
        <field name="bp_systolic" string="SYS" widget="integer"/>
        <field name="bp_diastolic" string="DIA" widget="integer"/>
        <field name="spo2" string="SpO2 %" widget="integer"
               decoration-danger="spo2 &lt; 90"
               decoration-warning="spo2 &lt; 94 and spo2 >= 90"/>
        <field name="temperature" string="Temp C" widget="integer" optional="show"/>
        <field name="glucose" string="Glucose" widget="integer" optional="show"/>
        <field name="ai_score" string="AI Risk" widget="progressbar"
               decoration-danger="ai_score >= 70"
               decoration-warning="ai_score >= 40 and ai_score &lt; 70"
               decoration-success="ai_score &lt; 40"/>
        <field name="ai_analysis_state" string="AI Status" widget="badge"
               decoration-info="ai_analysis_state in ['pending', 'retrying']"
               decoration-success="ai_analysis_state == 'analyzed'"
               decoration-danger="ai_analysis_state == 'failed'"
               optional="show"/>
        <field name="confirmation_state" string="Confirmation" widget="badge"
               decoration-warning="confirmation_state=='pending'"
               decoration-info="confirmation_state=='confirmed'"
               optional="show"/>
        <field name="status" string="Triage" widget="badge"
               decoration-danger="status=='critical'"
               decoration-warning="status=='warning'"
               decoration-muted="status=='normal'"/>
      </tree>
    </field>
  </record>

  <!-- VITALS GRAPH VIEW -->
  <record id="view_vitals_graph" model="ir.ui.view">
    <field name="name">health.vital.record.graph</field>
    <field name="model">health.vital.record</field>
    <field name="arch" type="xml">
      <graph string="Vitals Analysis" type="line">
        <field name="recorded_at" interval="day"/>
        <field name="heart_rate" type="measure"/>
        <field name="bp_systolic" type="measure"/>
      </graph>
    </field>
  </record>

  <!-- VITALS PIVOT VIEW -->
  <record id="view_vitals_pivot" model="ir.ui.view">
    <field name="name">health.vital.record.pivot</field>
    <field name="model">health.vital.record</field>
    <field name="arch" type="xml">
      <pivot string="Vitals Pivot">
        <field name="recorded_at" interval="month" type="row"/>
        <field name="patient_id" type="row"/>
        <field name="heart_rate" type="measure"/>
        <field name="bp_systolic" type="measure"/>
        <field name="ai_score" type="measure"/>
      </pivot>
    </field>
  </record>

  <!-- VITALS SEARCH VIEW -->
  <record id="view_vitals_search" model="ir.ui.view">
    <field name="name">health.vital.record.search</field>
    <field name="model">health.vital.record</field>
    <field name="arch" type="xml">
      <search>
        <field name="patient_id"/>
        <filter string="Anomalies Detected" name="anomalies" domain="[('anomaly_detected', '=', True)]"/>
        <filter string="Pending Confirmation" name="pending_confirmation" domain="[('confirmation_state', '=', 'pending')]"/>
        <filter string="Normal Records" name="normal" domain="[('anomaly_detected', '=', False)]"/>
        <separator/>
        <filter string="Today's Vitals" name="today" domain="[('recorded_at', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('recorded_at', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
        <group expand="0" string="Group By">
          <filter string="Patient" name="group_by_patient" context="{'group_by':'patient_id'}"/>
          <filter string="Date" name="group_by_date" context="{'group_by':'recorded_at:day'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ACTIONS -->
  <record id="action_vitals_all" model="ir.actions.act_window">
    <field name="name">All Vital Records</field>
    <field name="res_model">health.vital.record</field>
    <field name="view_mode">tree,form,graph</field>
    <field name="search_view_id" ref="view_vitals_search"/>
    <field name="context">{'search_default_today': 1}</field>
  </record>

  <record id="action_patient_vitals" model="ir.actions.act_window">
    <field name="name">Patient Vitals</field>
    <field name="res_model">health.vital.record</field>
    <field name="view_mode">tree,form,graph</field>
    <field name="domain">[('patient_id', '=', active_id)]</field>
    <field name="context">{'default_patient_id': active_id}</field>
  </record>

  <record id="action_retrain_ai" model="ir.actions.server">
      <field name="name">Retrain AI Model</field>
      <field name="model_id" ref="model_health_vital_record"/>
      <field name="state">code</field>
      <field name="code">action = model.action_retrain_ai_model()</field>
      <field name="groups_id" eval="[(4, ref('health_monitoring.group_health_admin'))]"/>
      <field name="binding_model_id" ref="model_health_vital_record"/>
      <field name="binding_type">action</field>
  </record>

</odoo>
