<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- VITALS FORM VIEW -->
  <record id="view_vitals_form" model="ir.ui.view">
    <field name="name">health.vital.record.form</field>
    <field name="model">health.vital.record</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button string="Analyze &amp; Save" type="object" name="action_manual_save_close" class="btn-primary ms-2" invisible="id"/>
          <field name="status" widget="statusbar" statusbar_visible="normal,warning,critical"/>
        </header>
        <sheet>
          <field name="anomaly_detected" invisible="1"/>

          <!-- Page title — no fa icon -->
          <div class="oe_title mb-4">
            <div style="margin-bottom:14px;">
              <div style="font-size:18px;font-weight:600;color:#0F172A;letter-spacing:-0.3px;">Clinical Checkup</div>
              <div style="font-size:12px;color:#64748B;margin-top:3px;">Enter vital signs for AI analysis</div>
            </div>
          </div>

          <!-- Two-column layout: left cards + right AI panel -->
          <div class="row">
            <!-- Left: Clinical Data -->
            <div class="col-md-8">
              <div class="row sl-card-container mb-4">
                <!-- Cardiovascular card -->
                <div class="col-md-6 mb-3">
                  <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;height:100%;">
                    <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                      <div style="width:7px;height:7px;border-radius:50%;background:#185FA5;flex-shrink:0;"></div>
                      Cardiovascular
                    </div>
                    <group>
                      <field name="patient_id" widget="many2one_avatar" options="{'no_create': True}"/>
                      <label for="bp_systolic" string="Blood Pressure"/>
                      <div class="o_row">
                        <field name="bp_systolic" class="sl-numeric" placeholder="SYS"/>
                        <span class="mx-1">/</span>
                        <field name="bp_diastolic" class="sl-numeric" placeholder="DIA"/>
                      </div>
                      <field name="heart_rate" class="sl-numeric" string="Heart Rate (bpm)"/>
                    </group>
                  </div>
                </div>
                <!-- Respiratory card -->
                <div class="col-md-6 mb-3">
                  <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;height:100%;">
                    <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                      <div style="width:7px;height:7px;border-radius:50%;background:#16A34A;flex-shrink:0;"></div>
                      Respiratory
                    </div>
                    <group>
                      <field name="recorded_at"/>
                      <field name="spo2" class="sl-numeric" string="SpO2 (%)"/>
                      <field name="respiratory_rate" class="sl-numeric" string="Respiration (/min)"/>
                    </group>
                  </div>
                </div>
              </div>

              <!-- Metabolic card -->
              <div class="row sl-card-container">
                <div class="col-md-12">
                  <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;">
                    <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                      <div style="width:7px;height:7px;border-radius:50%;background:#F59E0B;flex-shrink:0;"></div>
                      Metabolic &amp; Temp
                    </div>
                    <div class="row">
                      <div class="col-md-6">
                        <group>
                          <field name="temperature" class="sl-numeric" string="Body Temp (°C)"/>
                        </group>
                      </div>
                      <div class="col-md-6">
                        <group>
                          <field name="glucose" class="sl-numeric" string="Glucose (mg/dL)"/>
                        </group>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right: AI Assessment Panel -->
            <div class="col-md-4">
              <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px;min-height:400px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;">

                <!-- Status icon circle — SVG, no fa -->
                <div style="width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-top:8px;background:#E24B4A;" invisible="not anomaly_detected">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                    <path d="M18 6L6 18M6 6l12 12" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div style="width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-top:8px;background:#16A34A;" invisible="anomaly_detected">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                    <path d="M20 6L9 17l-5-5" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>

                <div style="font-size:16px;font-weight:700;color:#E24B4A;" invisible="not anomaly_detected">Anomaly Detected</div>
                <div style="font-size:16px;font-weight:700;color:#16A34A;" invisible="anomaly_detected">Normal Status</div>

                <!-- Risk Score gauge -->
                <div style="background:#F8FAFC;border:1px solid #EEF2F7;border-radius:10px;padding:14px;width:100%;">
                  <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#94A3B8;margin-bottom:8px;">Clinical Risk Score</div>
                  <div style="display:flex;justify-content:center;min-height:130px;">
                    <field name="ai_score" widget="gauge" options="{'max_field': 100, 'title': ''}" nolabel="1"/>
                  </div>
                  <div style="font-size:18px;font-weight:700;font-family:monospace;color:#E24B4A;" invisible="not anomaly_detected">
                    <field name="ai_score" nolabel="1"/>%
                  </div>
                  <div style="font-size:18px;font-weight:700;font-family:monospace;color:#16A34A;" invisible="anomaly_detected">
                    <field name="ai_score" nolabel="1"/>%
                  </div>
                </div>

                <!-- Clinical analysis text -->
                <div style="background:#F8FAFC;border:1px solid #EEF2F7;border-radius:8px;padding:12px;width:100%;text-align:left;flex:1;overflow-y:auto;">
                  <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#94A3B8;margin-bottom:6px;">Clinical Analysis</div>
                  <field name="parsed_clinical_hints" nolabel="1"/>
                </div>
              </div>
            </div>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <!-- VITALS TREE VIEW -->
  <record id="view_vitals_tree" model="ir.ui.view">
    <field name="name">health.vital.record.tree</field>
    <field name="model">health.vital.record</field>
    <field name="arch" type="xml">
      <tree decoration-danger="status=='critical'" class="sl-clinical-grid" limit="20">
        <field name="recorded_at" string="Checked At"/>
        <field name="patient_id" widget="many2one_avatar" string="Patient Profile"/>
        <field name="heart_rate" string="Pulse (bpm)"/>
        <field name="bp_systolic" string="SYS"/>
        <field name="bp_diastolic" string="DIA"/>
        <field name="spo2" string="SpO2 (%)" decoration-danger="spo2 &lt; 90" decoration-warning="spo2 &lt; 95"/>
        <field name="temperature" string="Temp (°C)" optional="show"/>
        <field name="glucose" string="Glucose" optional="show"/>
        <field name="ai_score" string="AI Risk" widget="progressbar"/>
        <field name="status" string="Triage Status" widget="badge"
               decoration-danger="status=='critical'"
               decoration-warning="status=='warning'"
               decoration-muted="status=='normal'"/>
      </tree>
    </field>
  </record>

  <!-- VITALS GRAPH VIEW -->
  <record id="view_vitals_graph" model="ir.ui.view">
    <field name="name">health.vital.record.graph</field>
    <field name="model">health.vital.record</field>
    <field name="arch" type="xml">
      <graph string="Vitals Analysis" type="line">
        <field name="recorded_at" interval="day"/>
        <field name="heart_rate" type="measure"/>
        <field name="bp_systolic" type="measure"/>
      </graph>
    </field>
  </record>

  <!-- VITALS PIVOT VIEW -->
  <record id="view_vitals_pivot" model="ir.ui.view">
    <field name="name">health.vital.record.pivot</field>
    <field name="model">health.vital.record</field>
    <field name="arch" type="xml">
      <pivot string="Vitals Pivot">
        <field name="recorded_at" interval="month" type="row"/>
        <field name="patient_id" type="row"/>
        <field name="heart_rate" type="measure"/>
        <field name="bp_systolic" type="measure"/>
        <field name="ai_score" type="measure"/>
      </pivot>
    </field>
  </record>

  <!-- VITALS SEARCH VIEW -->
  <record id="view_vitals_search" model="ir.ui.view">
    <field name="name">health.vital.record.search</field>
    <field name="model">health.vital.record</field>
    <field name="arch" type="xml">
      <search>
        <field name="patient_id"/>
        <filter string="Anomalies Detected" name="anomalies" domain="[('anomaly_detected', '=', True)]"/>
        <filter string="Normal Records" name="normal" domain="[('anomaly_detected', '=', False)]"/>
        <separator/>
        <filter string="Today's Vitals" name="today" domain="[('recorded_at', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('recorded_at', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
        <group expand="0" string="Group By">
          <filter string="Patient" name="group_by_patient" context="{'group_by':'patient_id'}"/>
          <filter string="Date" name="group_by_date" context="{'group_by':'recorded_at:day'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ACTIONS -->
  <record id="action_vitals_all" model="ir.actions.act_window">
    <field name="name">All Vital Records</field>
    <field name="res_model">health.vital.record</field>
    <field name="view_mode">tree,form,graph</field>
    <field name="search_view_id" ref="view_vitals_search"/>
    <field name="context">{'search_default_today': 1}</field>
  </record>

  <record id="action_patient_vitals" model="ir.actions.act_window">
    <field name="name">Patient Vitals</field>
    <field name="res_model">health.vital.record</field>
    <field name="view_mode">tree,form,graph</field>
    <field name="domain">[('patient_id', '=', active_id)]</field>
    <field name="context">{'default_patient_id': active_id}</field>
  </record>

</odoo>
