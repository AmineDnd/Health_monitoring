<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- PATIENT FORM VIEW -->
  <record id="view_patient_form" model="ir.ui.view">
    <field name="name">health.patient.form</field>
    <field name="model">health.patient</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_admit" type="object" string="Admit to Ward" class="btn-primary" invisible="admission_status != 'triage'"/>
          <button name="action_validate" type="object" string="Validate Patient" class="btn-success" invisible="status == 'active'" groups="health_monitoring.group_health_doctor"/>
          <field name="status" widget="statusbar" statusbar_visible="draft,active"/>
          <field name="admission_status" widget="statusbar" statusbar_visible="triage,admitted,discharged"/>
          <field name="risk_level" widget="statusbar" statusbar_visible="low,medium,high,critical"/>
        </header>
        <sheet>
          <!-- Smart Buttons -->
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="action" name="%(action_patient_vitals)d" icon="fa-heartbeat">
              <field string="Vitals" name="vitals_count" widget="statinfo"/>
            </button>
            <button class="oe_stat_button" type="action" name="%(action_patient_alerts)d" icon="fa-bell" groups="health_monitoring.group_health_doctor">
              <field string="Total Alerts" name="alerts_count" widget="statinfo"/>
            </button>
            <button class="oe_stat_button" type="action" name="%(action_patient_critical_alerts)d" icon="fa-exclamation-triangle" context="{'search_default_critical': 1}" groups="health_monitoring.group_health_doctor">
              <div class="o_stat_info o_text_danger">
                <span class="o_stat_value"><field name="critical_alerts_count"/></span>
                <span class="o_stat_text">Critical</span>
              </div>
            </button>
          </div>

          <!-- Title Area -->
          <div class="oe_title mb-4">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:6px;">
              <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:44px;height:44px;border-radius:10px;background:#E6F1FB;color:#0C447C;font-size:15px;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  P
                </div>
                <div>
                  <field name="name" placeholder="Patient Name" style="font-size:20px;font-weight:700;color:#0F172A;display:block;"/>
                  <div style="font-size:12px;color:#64748B;margin-top:3px;display:flex;align-items:center;gap:6px;">
                    <span>Age <field name="age" nolabel="1" readonly="1" style="font-weight:600;color:#334155;display:inline;"/></span>
                    <span style="color:#CBD5E1;">·</span>
                    <field name="gender" nolabel="1" readonly="1" style="color:#334155;font-weight:600;display:inline;"/>
                    <span style="color:#CBD5E1;">·</span>
                    <field name="category" nolabel="1" readonly="1" style="color:#334155;font-weight:600;display:inline;"/>
                    <span style="color:#CBD5E1;">·</span>
                    <field name="profile_male" nolabel="1" readonly="1" invisible="gender == 'female'" style="color:#334155;font-weight:600;display:inline;"/>
                    <field name="profile_female" nolabel="1" readonly="1" invisible="gender != 'female'" style="color:#334155;font-weight:600;display:inline;"/>
                  </div>
                </div>
              </div>
              <field name="risk_level" widget="badge"
                     decoration-danger="risk_level=='critical'"
                     decoration-warning="risk_level=='high'"
                     decoration-info="risk_level=='handled'"
                     decoration-primary="risk_level=='medium'"
                     decoration-success="risk_level=='low'"
                     style="font-size:12px;font-weight:600;align-self:flex-start;"/>
            </div>
          </div>

          <!-- AI Admission Recommendation Banners -->
          <div class="row" invisible="not ai_recommendation_msg or admission_status != 'triage'">
            <div class="col-12 mb-4">
              <!-- Critical Banner -->
              <div invisible="risk_level != 'critical'" style="background:#fff;border-left:4px solid #E24B4A;border:1px solid #EEF2F7;border-left:4px solid #E24B4A;border-radius:8px;padding:14px 16px;margin-bottom:8px;">
                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
                  <div>
                    <div style="font-size:13px;font-weight:600;color:#0F172A;">ICU Admission Recommended</div>
                    <div style="font-size:12px;color:#64748B;margin-top:2px;"><field name="ai_recommendation_msg" readonly="1" nolabel="1"/></div>
                  </div>
                  <div style="display:flex;align-items:center;gap:10px;">
                    <span style="font-size:12px;color:#64748B;">Target: <field name="ai_recommended_ward_id" readonly="1" nolabel="1" options="{'no_open': True}" style="font-weight:600;color:#0F172A;"/></span>
                    <button name="action_admit_ai" type="object" string="Admit Patient" class="btn btn-sm btn-danger"/>
                  </div>
                </div>
              </div>

              <!-- Stable Banner -->
              <div invisible="risk_level == 'critical'" style="background:#fff;border:1px solid #EEF2F7;border-left:4px solid #16A34A;border-radius:8px;padding:14px 16px;">
                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
                  <div>
                    <div style="font-size:13px;font-weight:600;color:#0F172A;">General Admission Recommended</div>
                    <div style="font-size:12px;color:#64748B;margin-top:2px;"><field name="ai_recommendation_msg" readonly="1" nolabel="1"/></div>
                  </div>
                  <div style="display:flex;align-items:center;gap:10px;">
                    <span style="font-size:12px;color:#64748B;">Target: <field name="ai_recommended_ward_id" readonly="1" nolabel="1" options="{'no_open': True}" style="font-weight:600;color:#0F172A;"/></span>
                    <button name="action_admit_ai" type="object" string="Admit Patient" class="btn btn-sm btn-success"/>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Two Info Cards -->
          <div class="row sl-card-container">
            <div class="col-md-6 mb-3">
              <div class="sl-card" style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;">
                <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                  <div style="width:7px;height:7px;border-radius:50%;background:#185FA5;flex-shrink:0;"></div>
                  Personal Profile
                </div>
                <group>
                  <field name="age"/>
                  <field name="gender" widget="radio" options="{'horizontal': true}"/>
                  <field name="category" widget="badge"
                         decoration-info="category=='child'"
                         decoration-warning="category=='elderly'"
                         decoration-success="category=='adult'"
                         decoration-primary="category=='teen'"/>
                  <field name="lifestyle_profile" invisible="1"/>
                  <field name="profile_male" invisible="gender == 'female'" required="1"/>
                  <field name="profile_female" invisible="gender != 'female'" required="1"/>
                </group>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <div class="sl-card" style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;">
                <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                  <div style="width:7px;height:7px;border-radius:50%;background:#16A34A;flex-shrink:0;"></div>
                  Medical Context
                </div>
                <group>
                  <field name="is_doctor" invisible="1"/>
                  <field name="ward_id" options="{'no_create': True}" placeholder="Select Ward for Admission"/>
                  <field name="doctor_id" widget="many2one_avatar_user" options="{'no_create': True}" readonly="not is_doctor"/>
                  <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="not is_doctor"/>
                </group>
              </div>
            </div>
          </div>

          <!-- AI Risk Assessment Card -->
          <div class="row sl-card-container">
            <div class="col-md-12 mb-3">
              <div class="sl-card" style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;padding:16px 18px;">
                <div style="display:flex;align-items:center;gap:7px;margin-bottom:12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:#94A3B8;">
                  <div style="width:7px;height:7px;border-radius:50%;background:#E24B4A;flex-shrink:0;"></div>
                  AI Risk Assessment
                </div>

                <!-- Attention banner -->
                <div class="sl-ai-alert-box" invisible="risk_level in ['low', 'medium'] or last_alert_state in ['investigating', 'resolved']">
                  <div>
                    <strong>Attention Required</strong><br/>
                    <span style="font-size:12px;">This patient has a high AI risk score. Please review latest vitals.</span>
                  </div>
                </div>

                <!-- Handled banner -->
                <div invisible="last_alert_state not in ['investigating', 'resolved']" style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:#EAF3DE;border-left:3px solid #16A34A;border-radius:8px;margin-bottom:12px;">
                  <div>
                    <strong style="color:#16A34A;font-size:13px;">Vitals Handled</strong><br/>
                    <span style="font-size:12px;color:#64748B;">Latest critical vitals are being investigated or are resolved.</span>
                  </div>
                </div>

                <div class="row align-items-center mt-3 mb-2">
                  <div class="col-md-4 text-center border-end">
                    <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:#94A3B8;margin-bottom:4px;">Predicted AI Score</div>
                    <div style="display:flex;justify-content:center;margin-top:-5px;margin-bottom:-10px;">
                      <field name="last_score" widget="gauge" nolabel="1" style="width:180px;height:130px;" options="{'max_value': 100}"/>
                    </div>
                  </div>
                  <div class="col-md-8 ps-4">
                    <group>
                      <field name="last_alert_id" readonly="1" string="Active AI Alert" invisible="not last_alert_id"/>
                      <field name="risk_level" widget="badge" string="Current Triage"
                             decoration-danger="risk_level=='critical'"
                             decoration-warning="risk_level=='high'"
                             decoration-info="risk_level=='handled'"
                             decoration-primary="risk_level=='medium'"
                             decoration-success="risk_level=='low'"/>
                      <field name="last_alert_state" invisible="1"/>
                    </group>
                    <div style="padding:8px 12px;background:#F8FAFC;border-radius:8px;border-left:3px solid #185FA5;font-size:11px;color:#64748B;margin-top:8px;">
                      Risk assessment updates automatically on every new vital check.
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tabs -->
          <notebook>
            <page string="Overview" name="overview" class="sl-overview-page">
              <div class="row mt-3">
                <div class="col-md-7">
                  <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;overflow:hidden;">
                    <div style="padding:10px 14px;border-bottom:1px solid #EEF2F7;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#E24B4A;">
                      Critical Notifications
                    </div>
                    <div style="max-height:400px;overflow-y:auto;">
                      <field name="alert_ids" readonly="1">
                        <tree decoration-danger="severity=='critical'" limit="5" no_open="1" class="sl-clinical-grid">
                          <field name="create_date" string="Time"/>
                          <field name="severity" widget="badge" string="Level"
                                 decoration-danger="severity=='critical'"
                                 decoration-warning="severity=='high'"
                                 decoration-muted="severity in ['medium', 'low']"/>
                          <field name="headline" string="Clinical Headline"/>
                          <field name="state" widget="badge" string="Status"
                                 decoration-success="state=='resolved'"
                                 decoration-info="state=='investigating'"
                                 decoration-muted="state=='new'"/>
                        </tree>
                      </field>
                    </div>
                  </div>
                </div>
                <div class="col-md-5 border-start ps-4">
                  <div style="background:#fff;border:1px solid #EEF2F7;border-radius:12px;overflow:hidden;">
                    <div style="padding:10px 14px;border-bottom:1px solid #EEF2F7;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#185FA5;">
                      Recent Vitals
                    </div>
                    <div style="max-height:400px;overflow-y:auto;">
                      <field name="vital_record_ids" readonly="1">
                        <tree limit="8" no_open="1" class="sl-clinical-grid">
                          <field name="recorded_at" string="Checked At"/>
                          <field name="heart_rate" string="Pulse"/>
                          <field name="bp_systolic" string="BP (Sys)"/>
                          <field name="spo2" string="SpO2 (%)" decoration-danger="spo2 &lt; 90" decoration-warning="spo2 &lt; 95"/>
                          <field name="ai_score" string="Risk"/>
                        </tree>
                      </field>
                    </div>
                  </div>
                </div>
              </div>
            </page>
            <page string="Vitals" name="vitals">
              <field name="vital_record_ids"/>
            </page>
            <page string="Alerts" name="alerts" groups="health_monitoring.group_health_doctor">
              <field name="alert_ids"/>
            </page>
          </notebook>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="message_ids"/>
        </div>
      </form>
    </field>
  </record>

  <!-- PATIENT LIST VIEW -->
  <record id="view_patient_tree" model="ir.ui.view">
    <field name="name">health.patient.tree</field>
    <field name="model">health.patient</field>
    <field name="arch" type="xml">
      <tree decoration-danger="risk_level=='critical'" class="sl-clinical-grid" limit="20">
        <field name="name" string="Patient Identity" decoration-bf="1"/>
        <field name="admission_status" widget="badge" string="Admission"
               decoration-info="admission_status=='triage'"
               decoration-success="admission_status=='admitted'"
               decoration-muted="admission_status=='discharged'"/>
        <field name="risk_level" widget="badge" string="Triage Level"
               decoration-danger="risk_level=='critical'"
               decoration-warning="risk_level=='high'"
               decoration-muted="risk_level in ['handled', 'medium', 'low']"/>
        <field name="dashboard_risk_score" widget="progressbar" string="AI Clinical Prediction"/>
        <field name="doctor_id" widget="many2one_avatar_user" string="In-Charge Doctor"/>
        <field name="age" string="Age" optional="show"/>
        <field name="category" widget="badge" string="Profile" optional="hide"/>
        <field name="tag_ids" widget="many2many_tags" string="Medical Tags" options="{'color_field': 'color'}" optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- PATIENT KANBAN VIEW -->
  <record id="view_patient_kanban" model="ir.ui.view">
    <field name="name">health.patient.kanban</field>
    <field name="model">health.patient</field>
    <field name="arch" type="xml">
      <kanban>
        <field name="id"/>
        <field name="name"/>
        <field name="admission_status"/>
        <field name="risk_level"/>
        <field name="dashboard_risk_score"/>
        <field name="doctor_id"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_card oe_kanban_global_click"
                 t-attf-style="border-top: 3px solid #{record.risk_level.raw_value == 'critical' ? '#E24B4A' : record.risk_level.raw_value == 'high' ? '#F59E0B' : record.risk_level.raw_value == 'medium' ? '#185FA5' : '#16A34A'}; border-radius: 12px; box-shadow: none; border: 1px solid #EEF2F7; border-top-width: 3px;">
              <div style="padding:14px;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                  <div style="display:flex;align-items:center;gap:10px;">
                    <div style="width:38px;height:38px;border-radius:50%;background:#E6F1FB;color:#0C447C;font-weight:600;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                      <t t-esc="record.name.value ? record.name.value.substring(0,2).toUpperCase() : 'P'"/>
                    </div>
                    <div>
                      <div style="font-size:14px;font-weight:600;color:#0F172A;line-height:1.2;"><field name="name"/></div>
                      <div style="font-size:11px;color:#64748B;"><field name="doctor_id"/></div>
                    </div>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:4px;align-items:flex-end;">
                    <span t-attf-style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:600;background:#{record.admission_status.raw_value == 'triage' ? '#E6F1FB' : record.admission_status.raw_value == 'admitted' ? '#EAF3DE' : '#F1F5F9'};color:#{record.admission_status.raw_value == 'triage' ? '#0C447C' : record.admission_status.raw_value == 'admitted' ? '#3B6D11' : '#64748B'};">
                      <field name="admission_status"/>
                    </span>
                    <span t-attf-style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:600;background:#{record.risk_level.raw_value == 'critical' ? '#FCEBEB' : record.risk_level.raw_value == 'high' ? '#FAEEDA' : record.risk_level.raw_value == 'medium' ? '#E6F1FB' : '#EAF3DE'};color:#{record.risk_level.raw_value == 'critical' ? '#A32D2D' : record.risk_level.raw_value == 'high' ? '#854F0B' : record.risk_level.raw_value == 'medium' ? '#0C447C' : '#3B6D11'};">
                      <field name="risk_level"/>
                    </span>
                  </div>
                </div>

                <div style="background:#F8FAFC;padding:8px 10px;border-radius:8px;margin-top:4px;">
                  <div style="display:flex;justify-content:space-between;margin-bottom:5px;font-size:11px;">
                    <span style="color:#64748B;font-weight:600;">AI Risk</span>
                    <span style="color:#0F172A;font-weight:600;"><t t-esc="Math.round(record.dashboard_risk_score.raw_value || 0)"/>%</span>
                  </div>
                  <div style="height:5px;border-radius:3px;background:#E2E8F0;overflow:hidden;">
                    <div role="progressbar"
                         t-attf-style="height:100%;border-radius:3px;width:#{record.dashboard_risk_score.raw_value || 0}%;background:#{record.risk_level.raw_value == 'critical' ? '#E24B4A' : record.risk_level.raw_value == 'high' ? '#F59E0B' : record.risk_level.raw_value == 'medium' ? '#185FA5' : '#16A34A'};"
                         t-att-aria-valuenow="record.dashboard_risk_score.raw_value || 0"
                         aria-valuemin="0" aria-valuemax="100"/>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- PATIENT SEARCH VIEW -->
  <record id="view_patient_search" model="ir.ui.view">
    <field name="name">health.patient.search</field>
    <field name="model">health.patient</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="doctor_id"/>
        <filter string="Critical Risk Patients" name="critical" domain="[('risk_level', '=', 'critical')]"/>
        <filter string="High &amp; Critical Risk" name="high_critical" domain="[('risk_level', 'in', ['high', 'critical'])]"/>
        <separator/>
        <filter string="My Patients" name="my_patients" domain="[('doctor_id', '=', uid)]"/>
        <group expand="0" string="Group By">
          <filter string="Risk Level" name="group_by_risk" context="{'group_by':'risk_level'}"/>
          <filter string="Assigned Doctor" name="group_by_doctor" context="{'group_by':'doctor_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_patients" model="ir.actions.act_window">
    <field name="name">Patients Registry</field>
    <field name="res_model">health.patient</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="search_view_id" ref="view_patient_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Register the first patient!
      </p>
      <p>
        Add a patient to start monitoring their vitals and AI risk trends.
      </p>
    </field>
  </record>

</odoo>
