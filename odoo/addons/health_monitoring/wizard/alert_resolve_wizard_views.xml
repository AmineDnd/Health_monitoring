<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_alert_resolve_wizard_form" model="ir.ui.view">
        <field name="name">health.alert.resolve.wizard.form</field>
        <field name="model">health.alert.resolve.wizard</field>
        <field name="arch" type="xml">
            <form string="Resolve Alert">
                <group>
                    <field name="alert_id" invisible="1"/>
                    <field name="resolution_notes" placeholder="Please provide details on what action was taken..."/>
                </group>
                <footer>
                    <button name="action_confirm_resolve" type="object" string="Resolve Alert" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
