<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_vital_confirm_wizard_form" model="ir.ui.view">
    <field name="name">health.vital.confirm.wizard.form</field>
    <field name="model">health.vital.confirm.wizard</field>
    <field name="arch" type="xml">
      <form string="Verify Vital Readings">

        <sheet style="padding:0;margin:0;">

          <!-- ── TOP ACCENT BAR ─────────────────────────────────── -->
          <div style="height:4px;background:linear-gradient(90deg,#E24B4A 0%,#F59E0B 100%);border-radius:4px 4px 0 0;"/>

          <!-- ── HEADER ──────────────────────────────────────────── -->
          <div style="padding:20px 24px 16px;border-bottom:1px solid #F1F5F9;display:flex;align-items:center;gap:14px;">
            <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#FEE2E2 0%,#FECACA 100%);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 2px 8px rgba(226,75,74,0.15);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
                      stroke="#DC2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <div style="font-size:15px;font-weight:700;color:#0F172A;letter-spacing:-0.2px;line-height:1.2;">Extreme Values Detected</div>
              <div style="font-size:11px;color:#94A3B8;margin-top:3px;font-weight:400;">Review the readings below before saving</div>
            </div>
          </div>

          <!-- ── HIDDEN FIELDS ──────────────────────────────────── -->
          <field name="vital_record_id" invisible="1"/>

          <!-- ── WARNINGS BLOCK ─────────────────────────────────── -->
          <div style="padding:16px 24px 0;">
            <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#94A3B8;margin-bottom:8px;">
              Outside extreme safety range
            </div>
            <div style="background:#FFF5F5;border:1px solid #FED7D7;border-radius:10px;padding:14px 16px;">
              <field name="warnings_text" nolabel="1" readonly="1"
                     style="white-space:pre-line;font-size:12.5px;font-weight:500;color:#7F1D1D;line-height:2;font-family:'Inter',system-ui,sans-serif;border:none;background:transparent;padding:0;width:100%;resize:none;"/>
            </div>
          </div>

          <!-- ── ADVISORY NOTE ──────────────────────────────────── -->
          <div style="padding:12px 24px 0;">
            <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#94A3B8;margin-bottom:8px;">
              Confirmation notes
            </div>
            <field name="confirmation_notes" nolabel="1"
                   placeholder="Example: repeated measurement manually, second device matched, patient assessed at bedside."
                   style="min-height:76px;font-size:12.5px;color:#0F172A;line-height:1.6;"/>
          </div>

          <div style="padding:12px 24px 20px;">
            <div style="background:#F0F7FF;border:1px solid #BFDBFE;border-radius:8px;padding:10px 14px;display:flex;align-items:flex-start;gap:10px;">
              <svg style="flex-shrink:0;margin-top:1px;" width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      stroke="#185FA5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div style="font-size:11.5px;color:#1E3A5F;line-height:1.6;">
                If this is a real emergency, confirm to save - the system will alert the care team.
                If these were entry errors, click <b>Re-enter Values</b> to correct them.
              </div>
            </div>
          </div>

        </sheet>

        <!-- ── FOOTER BUTTONS ─────────────────────────────────────── -->
        <footer style="padding:12px 20px;background:#F8FAFC;border-top:1px solid #F1F5F9;display:flex;justify-content:flex-end;gap:8px;">
          <button string="Re-enter Values"
                  name="action_reenter"
                  type="object"
                  style="padding:9px 20px;border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;background:#FFFFFF;border:1px solid #E2E8F0;color:#475569;font-family:'Inter',system-ui,sans-serif;transition:background 0.15s;"
                  class="btn"/>
          <button string="Confirm &amp; Save"
                  name="action_confirm"
                  type="object"
                  style="padding:9px 22px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;background:linear-gradient(135deg,#E24B4A,#C0392B);color:#fff;border:none;font-family:'Inter',system-ui,sans-serif;box-shadow:0 2px 8px rgba(226,75,74,0.3);"
                  class="btn btn-danger"/>
        </footer>

      </form>
    </field>
  </record>

</odoo>
