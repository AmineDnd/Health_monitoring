<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_patient_admit_wizard_form" model="ir.ui.view">
        <field name="name">health.patient.admit.wizard.form</field>
        <field name="model">health.patient.admit.wizard</field>
        <field name="arch" type="xml">
            <form string="Admit Patient">
                <sheet>
                    <!-- Patient banner -->
                    <div style="background:#F0F9FF;border:1px solid #BAE6FD;border-radius:8px;padding:12px 16px;margin-bottom:16px;">
                        <div style="font-size:13px;font-weight:600;color:#0C4A6E;">
                            Admitting: <field name="patient_name" readonly="1" nolabel="1" style="display:inline;"/>
                        </div>
                        <div style="font-size:12px;color:#475569;margin-top:4px;" invisible="not ai_recommended_ward_id">
                            <span style="color:#16A34A;font-weight:600;">AI Recommendation:</span>
                            <field name="ai_recommendation_msg" nolabel="1" readonly="1" style="display:inline;color:#64748B;"/>
                        </div>
                        <div style="font-size:12px;color:#94A3B8;margin-top:2px;" invisible="not ai_recommended_ward_id">
                            Suggested ward pre-filled below. You may change it.
                        </div>
                    </div>

                    <group>
                        <field name="patient_id" invisible="1"/>
                        <field name="ai_recommended_ward_id" invisible="1"/>
                        <field name="ai_recommendation_msg" invisible="1"/>
                        <field name="risk_level" invisible="1"/>

                        <field name="ward_id"
                               string="Assign to Ward"
                               options="{'no_create': True}"
                               placeholder="Select a ward..."/>
                        <field name="notes"
                               string="Admission Notes"
                               placeholder="Optional clinical notes for this admission..."/>
                    </group>

                    <!-- AI recommendation highlight -->
                    <div invisible="not ai_recommended_ward_id"
                         style="background:#F0FDF4;border:1px solid #BBF7D0;border-radius:6px;padding:8px 12px;margin-top:4px;font-size:12px;color:#166534;">
                        <i class="fa fa-robot me-1"/>
                        AI suggests: <field name="ai_recommended_ward_id" nolabel="1" readonly="1"
                               options="{'no_open': True}" style="display:inline;font-weight:600;"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_admit"
                            type="object"
                            string="Confirm Admission"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Access rule defined here (after model is loaded) instead of CSV -->
    <record id="access_patient_admit_wizard" model="ir.model.access">
        <field name="name">health.patient.admit.wizard access</field>
        <field name="model_id" ref="model_health_patient_admit_wizard"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>

